<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %></title>

  <!-- PWA & Mobile Standalone App Support (เปิดแอปเต็มจอ ไม่มีแถบ URL) -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1d4ed8">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="RoomReserve">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png">

  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
  <script src="/session-guard.js"></script>
  <style>
    /* Timeline Slot Grid */
    .room-slot-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      border-bottom: 1px dashed var(--border);
    }
    .room-slot-row:last-child {
      border-bottom: none;
    }
    .room-slot-info {
      width: 200px;
      flex-shrink: 0;
    }
    .slots-container {
      display: flex;
      gap: 3px;
      flex: 1;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .slot-block {
      flex: 1;
      min-width: 40px;
      height: 36px;
      border-radius: 6px;
      font-size: 0.65rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      user-select: none;
      text-align: center;
      border: 1px solid transparent;
    }
    .slot-free {
      background: #ecfdf5;
      color: #065f46;
      border-color: #a7f3d0;
    }
    .slot-free:hover {
      background: #10b981;
      color: white;
      transform: scale(1.05);
    }
    .slot-pending {
      background: #fef3c7;
      color: #92400e;
      border-color: #fde68a;
    }
    .slot-booked {
      background: #e0e7ff;
      color: #3730a3;
      border-color: #c7d2fe;
    }
    .slot-blocked {
      background: #f1f5f9;
      color: #475569;
      border-color: #cbd5e1;
    }
    [data-theme="dark"] .slot-free {
      background: #064e3b;
      color: #a7f3d0;
      border-color: #047857;
    }
    [data-theme="dark"] .slot-pending {
      background: #451a03;
      color: #fde68a;
      border-color: #78350f;
    }
    [data-theme="dark"] .slot-booked {
      background: #1e1b4b;
      color: #c7d2fe;
      border-color: #312e81;
    }
    [data-theme="dark"] .slot-blocked {
      background: #1e293b;
      color: #94a3b8;
      border-color: #334155;
    }

    /* Modal File Preview */
    .preview-modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.75);
      z-index: 999;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }
    .preview-modal-content {
      background: white;
      width: 90%;
      max-width: 850px;
      height: 82vh;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    }
    [data-theme="dark"] .preview-modal-content {
      background: #111827;
      border: 1px solid #374151;
    }
    .preview-modal-header {
      padding: 1rem 1.5rem;
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    [data-theme="dark"] .preview-modal-header {
      background: #1f2937;
      border-bottom-color: #374151;
      color: #f8fafc;
    }
    .preview-modal-body {
      flex: 1;
      background: #0f172a;
    }
    .preview-modal-body iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
  </style>
</head>
<body class="role-requester">

  <!-- Modal สำหรับดูไฟล์แนบ In-App Stream -->
  <div id="filePreviewModal" class="preview-modal-overlay" onclick="closePreviewModal(event)">
    <div class="preview-modal-content" onclick="event.stopPropagation()">
      <div class="preview-modal-header">
        <div>
          <strong id="previewFileName" style="font-size: 1rem; color: var(--dark);">ดูเอกสารแนบ</strong>
          <span style="font-size: 0.75rem; color: var(--muted); display: block;">Protected Storage (Anti-IDOR Stream)</span>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <a id="previewDownloadBtn" href="#" class="btn btn-primary btn-sm" download>ดาวน์โหลดไฟล์</a>
          <button type="button" class="btn btn-outline btn-sm" onclick="closePreviewModal()">ปิด</button>
        </div>
      </div>
      <div class="preview-modal-body">
        <iframe id="previewFrame" src="about:blank"></iframe>
      </div>
    </div>
  </div>

  <!-- Modal สำหรับระบุเหตุผลการปฏิเสธคำขอ (Approver Rejection Modal) -->
  <div id="rejectModal" class="preview-modal-overlay" onclick="closeRejectModal(event)" style="display: none;">
    <div class="casual-modal-box" onclick="event.stopPropagation()">
      <div class="casual-modal-header">
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #991b1b; margin: 0 0 0.25rem 0;">
            ปฏิเสธคำขอจองห้อง (Reject Booking)
          </h3>
          <div id="rejectModalSubTitle" style="font-size: 0.8rem; color: #7f1d1d;"></div>
        </div>
        <button type="button" class="btn btn-outline btn-sm" onclick="closeRejectModal()">ปิด</button>
      </div>

      <form id="rejectForm" method="POST" style="padding: 1.25rem 1.5rem;">
        <input type="hidden" name="action" value="REJECT">
        
        <div style="margin-bottom: 1rem;">
          <label style="font-size: 0.8rem; font-weight: 700; display: block; margin-bottom: 0.4rem; color: var(--dark);">
            เลือกเหตุผลมาตรฐานด่วน:
          </label>
          <div class="reject-preset-list">
            <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
              <input type="radio" name="preset_reason" value="ผู้บริหารมีความจำเป็นต้องใช้ห้องประชุมด่วนในช่วงเวลาดังกล่าว" checked onchange="applyPresetReason(this.value)">
              <span>ผู้บริหารมีความจำเป็นต้องใช้ห้องประชุมด่วน</span>
            </label>
            <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
              <input type="radio" name="preset_reason" value="กรุณาจัดประชุมในรูปแบบออนไลน์ (Online Meeting) แทนเพื่อประหยัดทรัพยากร" onchange="applyPresetReason(this.value)">
              <span>กรุณาจัดประชุมในรูปแบบออนไลน์แทน</span>
            </label>
            <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
              <input type="radio" name="preset_reason" value="จำนวนผู้เข้าร่วมไม่สอดคล้องกับขนาดห้องประชุม กรุณาเลือกห้องที่มีขนาดเหมาะสม" onchange="applyPresetReason(this.value)">
              <span>จำนวนผู้เข้าร่วมไม่สอดคล้องกับขนาดห้องประชุม</span>
            </label>
            <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
              <input type="radio" name="preset_reason" value="มีกิจกรรมสำคัญส่วนกลางของบริษัททับซ้อนในช่วงเวลาดังกล่าว" onchange="applyPresetReason(this.value)">
              <span>มีกิจกรรมสำคัญส่วนกลางของบริษัททับซ้อน</span>
            </label>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label for="reject_comment_input" style="font-size: 0.8rem; font-weight: 700; color: var(--dark);">
            ข้อความเหตุผลที่จะแจ้งให้ผู้ยื่นจองทราบ *:
          </label>
          <textarea name="comment" id="reject_comment_input" class="form-control" rows="3" required>ผู้บริหารมีความจำเป็นต้องใช้ห้องประชุมด่วนในช่วงเวลาดังกล่าว</textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
          <button type="button" class="btn btn-outline btn-sm" onclick="closeRejectModal()">ยกเลิก</button>
          <button type="submit" class="btn btn-danger btn-sm">ยืนยันปฏิเสธคำขอ</button>
        </div>
      </form>
    </div>
  </div>


  <% 
    const perms = (locals.userPermissions && Array.isArray(locals.userPermissions)) ? locals.userPermissions : [];
    const isAdminUser = user.roleName === 'admin' || perms.includes('acl.manage');
    const canApprove = perms.includes('booking.approve') || isAdminUser;
    const canFacility = perms.includes('facility.checkin') || perms.includes('facility.checkout') || isAdminUser;
    const canBlockSchedule = perms.includes('room.block_schedule') || isAdminUser;
    const canBook = perms.includes('booking.create') || isAdminUser;
    const canViewOwnBookings = perms.includes('booking.read_own') || perms.includes('booking.read_all') || isAdminUser;

    // คำนวณเฉพาะคำขอที่ยังดำเนินอยู่ (ไม่นับรายการที่เสร็จสิ้น/ยกเลิก/ปฏิเสธ ขึ้นเตือนบน Navbar)
    const activeMyBookingsCount = (Array.isArray(myBookings) ? myBookings : []).filter(b => 
      ['PENDING_APPROVAL', 'APPROVED', 'IN_USE'].includes(b.status)
    ).length;
  %>

  <nav class="navbar">
    <div class="nav-left">
      <a href="/app" class="nav-brand" onclick="switchRequesterView('home'); return false;">
        <div class="nav-brand-logo">RR</div>
        <div class="nav-brand-text">
          <div class="nav-brand-title">RoomReserve</div>
          <div class="nav-brand-subtitle">Smart Meeting Space</div>
        </div>
      </a>
    </div>

    <div class="nav-menu">
      <button type="button" class="desktop-nav-item active" data-view="home" onclick="switchRequesterView('home', this)">
        หน้าแรก
      </button>

      <% if (canApprove) { %>
        <button type="button" class="desktop-nav-item" data-view="approvals" onclick="switchRequesterView('approvals', this)">
          รออนุมัติ
          <% if (pendingApprovals.length > 0) { %>
            <span class="desktop-nav-badge" style="background: #f59e0b;"><%= pendingApprovals.length %></span>
          <% } %>
        </button>
      <% } %>

      <% if (canFacility) { %>
        <button type="button" class="desktop-nav-item" data-view="facility" onclick="switchRequesterView('facility', this)">
          งานส่งมอบห้อง
          <% if (facilityTasks.length > 0) { %>
            <span class="desktop-nav-badge" style="background: #10b981;"><%= facilityTasks.length %></span>
          <% } %>
        </button>
      <% } %>

      <% if (canBlockSchedule) { %>
        <button type="button" class="desktop-nav-item" data-view="facility-block" onclick="switchRequesterView('facility-block', this)">
          ปิดซ่อมบำรุง
        </button>
      <% } %>

      <% if (isAdminUser) { %>
        <a href="/admin/acl" class="desktop-nav-item" style="text-decoration:none;">ตารางสิทธิ์ (ACL)</a>
        <a href="/admin/users" class="desktop-nav-item" style="text-decoration:none;">ผู้ใช้งาน</a>
        <a href="/admin/logs" class="desktop-nav-item" style="text-decoration:none;">Audit Logs</a>
        <button type="button" class="desktop-nav-item" data-view="timeline" onclick="switchRequesterView('timeline', this)">
          ผังช่วงเวลา
        </button>
      <% } %>

      <% if (canBook) { %>
        <button type="button" class="desktop-nav-item" data-view="booking" onclick="switchRequesterView('booking', this)">
          จองห้อง
        </button>
      <% } %>

      <% if (canViewOwnBookings) { %>
        <button type="button" class="desktop-nav-item" data-view="mybookings" onclick="switchRequesterView('mybookings', this)">
          การจองของฉัน
          <% if (activeMyBookingsCount > 0) { %>
            <span class="desktop-nav-badge"><%= activeMyBookingsCount %></span>
          <% } %>
        </button>
      <% } %>
    </div>

    <div class="nav-right">
      <div class="user-badge desktop-nav-item" data-view="profile" onclick="switchRequesterView('profile', this)" role="button" tabindex="0" title="คลิกเพื่อเปิดโปรไฟล์">
        <span><%= user.username %></span>
        <span class="role-pill"><%= user.roleName %></span>
      </div>
      <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" title="สลับโหมดมืด/สว่าง">โหมดมืด</button>
    </div>
  </nav>

  <div class="container">
    <% if (success) { %>
      <div class="alert alert-success" id="flashSuccessAlert" style="display: flex; justify-content: space-between; align-items: center;"><span><%= success %></span><button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;font-size:1.25rem;cursor:pointer;line-height:1;padding:0 4px;">&times;</button></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% 
      // คำนวณวันถัดไป และวันนี้ สำหรับปุ่ม 1-คลิก
      const curDate = new Date(selectedDate);
      const nextDate = new Date(curDate);
      nextDate.setDate(nextDate.getDate() + 1);
      const nextDateStr = nextDate.toISOString().split('T')[0];

      const todayStr = new Date().toISOString().split('T')[0];
      const isToday = selectedDate === todayStr;
      
      const formattedThaiDate = new Date(selectedDate + 'T00:00:00').toLocaleDateString('th-TH', { 
        weekday: 'long', 
        day: 'numeric', 
        month: 'long', 
        year: 'numeric' 
      });

      // คำนวณวันสำหรับปฏิทินจิ๋ว (Mini Calendar Strip)
      const miniCalDays = [];
      const baseCalDate = new Date(selectedDate + 'T00:00:00');
      const todayCalDate = new Date(todayStr + 'T00:00:00');
      
      let startCal = new Date(todayCalDate);
      const dayDiff = Math.round((baseCalDate.getTime() - todayCalDate.getTime()) / (1000 * 3600 * 24));
      
      if (dayDiff > 4) {
        startCal = new Date(baseCalDate);
        startCal.setDate(startCal.getDate() - 3);
        if (startCal < todayCalDate) startCal = new Date(todayCalDate);
      }
      
      const thaiDayNames = ['อา.', 'จ.', 'อ.', 'พ.', 'พฤ.', 'ศ.', 'ส.'];
      const thaiMonthShort = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

      for (let i = 0; i < 10; i++) {
        const d = new Date(startCal);
        d.setDate(d.getDate() + i);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const dStr = `${yyyy}-${mm}-${dd}`;
        const dayOfWeek = d.getDay();
        
        miniCalDays.push({
          dateStr: dStr,
          dayNum: d.getDate(),
          dayName: thaiDayNames[dayOfWeek],
          monthName: thaiMonthShort[d.getMonth()],
          isWeekend: dayOfWeek === 0 || dayOfWeek === 6,
          isToday: dStr === todayStr,
          isSelected: dStr === selectedDate
        });
      }

      // คำนวณสรุปสถิติวันนี้
      const activeRoomsCount = rooms.filter(r => r.is_active).length;
      const bookedRoomIds = new Set(dayBookings.map(b => b.room_id));
      const fullyFreeRoomsCount = rooms.filter(r => r.is_active && !bookedRoomIds.has(r.room_id)).length;
    %>


    <!-- Toast แจ้งเตือนเมื่อคลิกช่วงเวลาที่จองไม่ได้ -->
    <div id="slotNoticeToast" class="slot-notice-toast">
      <span id="slotNoticeText">ช่วงเวลานี้ถูกจอง/ปิดซ่อมแล้ว ไม่สามารถเลือกได้</span>
    </div>

    <!-- ================= UNIFIED MODERN APP CONTAINER (ทุก Role ใช้ Shell แบบเดียวกัน) ================= -->
    <div class="requester-view-container">

        <!-- ================= SUBVIEW 1: หน้าแรก (Home Dashboard - Screenshot 1) ================= -->
        <div id="req-view-home" class="req-subview">
          
          <!-- 1. Deep Blue Gradient Header -->
          <div class="hero-blue-header">
            <div class="hero-inner">
              <div class="hero-user-capsule">
                <div class="hero-avatar">
                  <%= user.fullName ? user.fullName.charAt(0) : 'U' %>
                </div>
                <div style="flex: 1;">
                  <div style="font-size: 1.25rem; font-weight: 800; line-height: 1.25;"><%= user.fullName %></div>
                  <div style="font-size: 0.82rem; opacity: 0.85; margin-top: 0.25rem;">
                    <span>สังกัด: <%= user.department || 'สำนักงานใหญ่' %></span>
                    <% if (user.roleName !== 'requester') { %>
                      &bull; <span class="role-pill" style="background: rgba(255,255,255,0.25); color: #fff; font-size: 0.7rem; padding: 2px 7px;"><%= user.roleDisplay %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Floating Quick Action Card (Role-Adaptive) -->
        <% if (isAdminUser) { %>
          <div class="quick-booking-card">
            <div class="quick-booking-tag" style="color: #6366f1;">ADMIN CONSOLE</div>
            <h3 class="quick-booking-title">ศูนย์จัดการและบริหารระบบส่วนกลาง</h3>
            <p style="font-size: 0.85rem; color: var(--muted); margin: -0.65rem 0 1.25rem 0;">
              ภาพรวมงานรออนุมัติ งานหน้างาน และผังช่วงเวลาความว่างของห้องประชุม
            </p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.5rem; margin-bottom: 0.75rem;">
              <button type="button" class="quick-booking-btn" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); font-size: 0.82rem; padding: 0.7rem 0.5rem;" onclick="switchRequesterView('approvals')">
                รออนุมัติ (<%= pendingApprovals.length %>)
              </button>
              <button type="button" class="quick-booking-btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); font-size: 0.82rem; padding: 0.7rem 0.5rem;" onclick="switchRequesterView('facility')">
                หน้างาน (<%= facilityTasks.length %>)
              </button>
              <button type="button" class="quick-booking-btn" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); font-size: 0.82rem; padding: 0.7rem 0.5rem;" onclick="switchRequesterView('timeline')">
                ผังไทม์ไลน์
              </button>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem; flex-wrap: wrap; gap: 0.5rem; font-size: 0.82rem;">
              <a href="/admin/acl" class="quick-booking-link" style="font-weight: 700; color: #4f46e5;">
                ตารางสิทธิ์ ACL Matrix &rarr;
              </a>
              <a href="/admin/users" class="quick-booking-link">
                จัดการผู้ใช้งาน &rarr;
              </a>
              <a href="/admin/logs" class="quick-booking-link">
                Audit Logs &rarr;
              </a>
              <a href="/app/rooms" class="quick-booking-link">
                จัดการห้อง &rarr;
              </a>
            </div>
          </div>
        <% } else if (canApprove) { %>
          <div class="quick-booking-card">
            <div class="quick-booking-tag" style="color: #f59e0b;">APPROVAL WORKFLOW</div>
            <h3 class="quick-booking-title">
              <% if (pendingApprovals.length > 0) { %>
                มีคำขอรอการพิจารณา <%= pendingApprovals.length %> รายการ
              <% } else { %>
                ไม่มีคำขอรออนุมัติในขณะนี้
              <% } %>
            </h3>
            <p style="font-size: 0.85rem; color: var(--muted); margin: -0.65rem 0 1.25rem 0;">
              ตรวจสอบรายละเอียดคำขอ อุปกรณ์ที่ต้องการ และเอกสารแนบเพื่อพิจารณาอนุมัติ
            </p>
            <button type="button" class="quick-booking-btn" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);" onclick="switchRequesterView('approvals')">
              ตรวจสอบคำขอรออนุมัติ (<%= pendingApprovals.length %>)
            </button>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
              <% if (canBook) { %>
                <a href="javascript:void(0)" class="quick-booking-link" onclick="switchRequesterView('booking')">
                  ต้องการจองห้องประชุมใหม่ &rarr;
                </a>
              <% } %>
              <% if (canViewOwnBookings) { %>
                <a href="javascript:void(0)" class="quick-booking-link" onclick="switchRequesterView('mybookings')">
                  รายการของฉัน (<%= myBookings.length %>) &rarr;
                </a>
              <% } %>
            </div>
          </div>
        <% } else if (canFacility) { %>
          <div class="quick-booking-card">
            <div class="quick-booking-tag" style="color: #10b981;">FACILITY OPERATIONS</div>
            <h3 class="quick-booking-title">
              <% if (facilityTasks.length > 0) { %>
                คิวงานส่งมอบห้อง & ตรวจสภาพ (<%= facilityTasks.length %> รายการ)
              <% } else { %>
                ไม่มีคิวงานส่งมอบห้องค้างในขณะนี้
              <% } %>
            </h3>
            <p style="font-size: 0.85rem; color: var(--muted); margin: -0.65rem 0 1.25rem 0;">
              จัดการ Check-in ส่งมอบห้อง และ Check-out ตรวจสภาพห้องหลังใช้งาน
            </p>
            <button type="button" class="quick-booking-btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);" onclick="switchRequesterView('facility')">
              จัดการงานหน้างาน & ปิดซ่อม (<%= facilityTasks.length %>)
            </button>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
              <a href="javascript:void(0)" class="quick-booking-link" onclick="switchRequesterView('facility')">
                ฟอร์มบล็อกปิดซ่อมห้อง &rarr;
              </a>
              <% if (canBook) { %>
                <a href="javascript:void(0)" class="quick-booking-link" onclick="switchRequesterView('booking')">
                  จองห้องประชุม &rarr;
                </a>
              <% } %>
            </div>
          </div>
        <% } else if (canBook) { %>
          <div class="quick-booking-card">
            <div class="quick-booking-tag">QUICK BOOKING</div>
            <h3 class="quick-booking-title">วันนี้ต้องการใช้ห้องประชุมไหม</h3>
            <p style="font-size: 0.85rem; color: var(--muted); margin: -0.65rem 0 1.25rem 0;">
              จองสะดวกรวดเร็ว ตรวจสอบความว่างแบบ Real-time พร้อมอุปกรณ์ครบครัน
            </p>
            <button type="button" class="quick-booking-btn" onclick="startBookingFlow()">
              เริ่มจองห้อง
            </button>
            <div>
              <a href="javascript:void(0)" class="quick-booking-link" onclick="switchRequesterView('mybookings')">
                ตรวจสอบประวัติคำขอของฉัน (<%= myBookings.length %> รายการ) &rarr;
              </a>
            </div>
          </div>
        <% } else { %>
          <div class="quick-booking-card" style="border-left: 4px solid var(--muted);">
            <div class="quick-booking-tag" style="color: var(--muted);">SCHEDULE VIEWER</div>
            <h3 class="quick-booking-title">ตารางสถานะห้องประชุมวันนี้</h3>
            <p style="font-size: 0.85rem; color: var(--muted); margin: -0.65rem 0 1.25rem 0;">
              คุณสามารถตรวจสอบความว่างของห้องประชุมและคิวการใช้งานได้แบบ Real-time
            </p>
            <% if (canViewOwnBookings) { %>
              <div>
                <a href="javascript:void(0)" class="quick-booking-link" onclick="switchRequesterView('mybookings')">
                  รายการคำขอของฉัน (<%= myBookings.length %> รายการ) &rarr;
                </a>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- แถบสรุปสถานะแบบกระชับ (Stat Summary Bar) สำหรับบทบาทบริหาร/จัดการ -->
        <% if (['approver', 'facility', 'admin'].includes(user.roleName)) { %>
          <div class="stat-summary-bar" style="margin: 0 0.5rem 1.25rem 0.5rem;">
            <div class="stat-chip">
              <span>ว่างตลอดวัน:</span>
              <strong><%= fullyFreeRoomsCount %> / <%= activeRoomsCount %> ห้อง</strong>
            </div>
            <div class="stat-chip">
              <span>มีคิววันนี้:</span>
              <strong><%= dayBookings.length %> รายการ</strong>
            </div>
            <% if (['approver', 'admin'].includes(user.roleName)) { %>
              <div class="stat-chip" style="border-left: 3px solid var(--warning); cursor: pointer;" onclick="switchRequesterView('approvals')">
                <span>รออนุมัติ:</span>
                <strong style="color: var(--warning);"><%= pendingApprovals.length %></strong>
              </div>
            <% } %>
            <% if (['facility', 'admin'].includes(user.roleName)) { %>
              <div class="stat-chip" style="border-left: 3px solid #10b981; cursor: pointer;" onclick="switchRequesterView('facility')">
                <span>งานหน้างาน:</span>
                <strong style="color: #10b981;"><%= facilityTasks.length %></strong>
              </div>
            <% } %>
          </div>
        <% } %>

          <!-- 3. Section อาคารประชุม (Building Cards) -->
          <div class="available-now-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="width: 9px; height: 9px; border-radius: 50%; background: #2563eb; display: inline-block; box-shadow: 0 0 8px #2563eb;"></span>
              <span style="font-size: 1.05rem; font-weight: 800; color: var(--dark);">อาคารประชุม</span>
            </div>
            <span style="font-size: 0.78rem; color: var(--muted);"><%= canBook ? 'เลือกอาคารเพื่อเริ่มจอง' : 'ภาพรวมอาคารประชุม' %></span>
          </div>

          <div class="building-cards-grid" style="margin-bottom: 1.5rem;">
            <div class="building-card" <%- canBook ? 'onclick="startBookingFlow(null, 1)"' : 'style="cursor: default;"' %>>
              <div class="building-card-img-wrap">
                <img src="/images/building1.jpg" alt="ตึก 1" class="building-card-img" onerror="this.src=\'/images/building1.jpg\'">
              </div>
              <div class="building-card-body">
                <div class="building-card-title">ตึก 1</div>
                <div class="building-card-rooms">ห้อง 101 &bull; ห้อง 102</div>
              </div>
            </div>

            <div class="building-card" <%- canBook ? 'onclick="startBookingFlow(null, 2)"' : 'style="cursor: default;"' %>>
              <div class="building-card-img-wrap">
                <img src="/images/building2.jpg" alt="ตึก 2" class="building-card-img" onerror="this.src=\'/images/building2.jpg\'">
              </div>
              <div class="building-card-body">
                <div class="building-card-title">ตึก 2</div>
                <div class="building-card-rooms">ห้อง 201 &bull; ห้อง 202</div>
              </div>
            </div>

            <div class="building-card" <%- canBook ? 'onclick="startBookingFlow(null, 3)"' : 'style="cursor: default;"' %>>
              <div class="building-card-img-wrap">
                <img src="/images/building3.jpg" alt="ตึก 3" class="building-card-img" onerror="this.src=\'/images/building3.jpg\'">
              </div>
              <div class="building-card-body">
                <div class="building-card-title">ตึก 3</div>
                <div class="building-card-rooms">ห้อง 301 &bull; ห้อง 302</div>
              </div>
            </div>
          </div>

        </div>


        <% if (canBook) { %>
        <!-- ================= SUBVIEW 2: การจองห้อง (Interactive Booking Flow - Screenshot 2) ================= -->
        <div id="req-view-booking" class="req-subview" style="display: none;">
          
          <!-- Stepper / Progress Header -->
          <div class="card" style="margin-bottom: 1rem; border-left: 4px solid #2563eb;">
            <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin: 0 0 0.35rem 0;">
              จองห้องประชุม (เลือกวันและเวลา)
            </h3>
            <p style="font-size: 0.82rem; color: var(--muted); margin: 0;">
              ขั้นตอนที่ 1/2: เลือกอาคาร ห้องประชุม และช่วงเวลาที่ต้องการใช้งาน
            </p>
          </div>

          <!-- อาคาร 1, 2, 3 พร้อมรูปภาพคมชัดตามที่ผู้ใช้กำหนด -->
          <div style="margin-bottom: 1.25rem;">
            <div style="font-size: 0.92rem; font-weight: 800; color: var(--dark); margin-bottom: 0.65rem; display: flex; align-items: center; gap: 0.4rem;">
              <span>เลือกอาคาร:</span>
              <span style="font-weight: 500; font-size: 0.8rem; color: var(--muted);">(กรุณาคลิกเลือกอาคารเพื่อดูห้องประชุม)</span>
            </div>

            <div class="building-cards-grid">
              <div class="building-card" onclick="selectBuilding(1, this)" id="btn-building-1">
                <div class="building-card-img-wrap">
                  <img src="/images/building1.jpg" alt="ตึก 1" class="building-card-img" onerror="this.src='/images/building1.jpg'">
                </div>
                <div class="building-card-body">
                  <div class="building-card-title">ตึก 1</div>
                  <div class="building-card-rooms">ห้อง 101 &bull; ห้อง 102</div>
                </div>
              </div>

              <div class="building-card" onclick="selectBuilding(2, this)" id="btn-building-2">
                <div class="building-card-img-wrap">
                  <img src="/images/building2.jpg" alt="ตึก 2" class="building-card-img" onerror="this.src='/images/building2.jpg'">
                </div>
                <div class="building-card-body">
                  <div class="building-card-title">ตึก 2</div>
                  <div class="building-card-rooms">ห้อง 201 &bull; ห้อง 202</div>
                </div>
              </div>

              <div class="building-card" onclick="selectBuilding(3, this)" id="btn-building-3">
                <div class="building-card-img-wrap">
                  <img src="/images/building3.jpg" alt="ตึก 3" class="building-card-img" onerror="this.src='/images/building3.jpg'">
                </div>
                <div class="building-card-body">
                  <div class="building-card-title">ตึก 3</div>
                  <div class="building-card-rooms">ห้อง 301 &bull; ห้อง 302</div>
                </div>
              </div>
            </div>
          </div>

          <!-- กล่องแสดงห้องในตึกที่เลือก (ซ่อนไว้ก่อน เริ่มต้น display: none) -->
          <div id="buildingRoomsBox" style="margin-bottom: 1.5rem; display: none;">
            <div style="font-size: 0.95rem; font-weight: 800; color: var(--dark); margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span id="buildingRoomsHeaderLabel">ห้องประชุมในอาคาร:</span>
                <span id="buildingRoomsTitle" style="font-weight: 500; font-size: 0.82rem; color: var(--muted);">(แตะที่การ์ดห้องเพื่อเลือก)</span>
              </div>
              <span id="selectedRoomNoticeBadge" style="font-size: 0.75rem; font-weight: 700; color: #2563eb; background: #eff6ff; padding: 0.2rem 0.65rem; border-radius: 9999px; display: none;">
                เลือกแล้ว
              </span>
            </div>
            <div class="visual-rooms-grid" id="visualRoomsGrid">
              <% rooms.forEach(room => { 
                let bNum = '1';
                if (room.location && room.location.includes('2')) bNum = '2';
                else if (room.location && room.location.includes('3')) bNum = '3';
                else if (room.room_name && (room.room_name.includes('201') || room.room_name.includes('202'))) bNum = '2';
                else if (room.room_name && (room.room_name.includes('301') || room.room_name.includes('302'))) bNum = '3';
                const bImg = `/images/building${bNum}.jpg`;
              %>
                <div class="visual-room-card" data-building="<%= bNum %>" data-room-id="<%= room.room_id %>" data-capacity="<%= room.capacity %>" onclick="selectBookingRoom('<%= room.room_id %>')">
                  <div class="visual-room-img-wrap">
                    <img src="<%= bImg %>" alt="<%= room.room_name %>" class="visual-room-img" onerror="this.src='/images/building1.jpg'">
                  </div>
                  <div class="visual-room-body">
                    <div class="visual-room-name"><%= room.room_name %></div>
                    <div class="visual-room-meta">
                      <span class="visual-room-badge"><%= room.location %></span>
                      <span class="visual-room-badge">รองรับ <%= room.capacity %> คน</span>
                    </div>
                  </div>
                  <input type="radio" name="visual_room_radio" class="visual-room-radio" value="<%= room.room_id %>" style="display: none;">
                </div>
              <% }) %>
            </div>
          </div>

          <!-- กล่องระบุวันเวลาและรายละเอียดการจอง (Unified Date & Time Booking Card) -->
          <div class="card" style="padding: 1.25rem;">
            <!-- ส่วนเลือกวันที่แบบปฏิทินจิ๋ว (Mini Calendar Strip) -->
            <div class="mini-calendar-container" style="border: none; background: transparent; padding: 0 0 1rem 0; margin-bottom: 1rem; border-bottom: 1px solid var(--border);">
              <div class="mini-calendar-header">
                <div class="mini-cal-title-group">
                  <div class="mini-cal-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span>วันที่เลือกใช้งาน:</span>
                  </div>
                  <div class="mini-cal-selected-text">
                    <span><%= formattedThaiDate %></span>
                    <% if (isToday) { %>
                      <span class="mini-cal-today-badge">วันนี้</span>
                    <% } %>
                  </div>
                </div>

                <div class="mini-cal-actions">
                  <% if (!isToday) { %>
                    <button type="button" class="mini-cal-today-btn" onclick="changeBookingDate('<%= todayStr %>')">
                      กลับสู่วันนี้
                    </button>
                  <% } %>
                  <div class="mini-cal-picker-form">
                    <input type="date" id="miniCalDateInput" name="date" value="<%= selectedDate %>" min="<%= todayStr %>" onchange="changeBookingDate(this.value)" class="form-control mini-cal-date-input" title="คลิกเพื่อเลือกวันอื่นในปฏิทิน">
                  </div>
                </div>
              </div>

              <!-- แถบปฏิทินจิ๋ว (Mini Calendar Date Strip) -->
              <div class="mini-calendar-strip-wrap">
                <button type="button" class="mini-cal-nav-btn prev" onclick="navigateMiniCal(-1)" title="เลื่อนดูวันก่อนหน้า">
                  &#8249;
                </button>
                
                <div class="mini-calendar-strip" id="miniCalendarStrip">
                  <% miniCalDays.forEach(day => { %>
                    <div class="mini-cal-day-card <%= day.isSelected ? 'active' : '' %> <%= day.isToday ? 'is-today' : '' %> <%= day.isWeekend ? 'is-weekend' : '' %>"
                         onclick="changeBookingDate('<%= day.dateStr %>')"
                         title="<%= day.dateStr %>">
                      <div class="mini-cal-day-name"><%= day.dayName %></div>
                      <div class="mini-cal-day-num"><%= day.dayNum %></div>
                      <div class="mini-cal-day-month"><%= day.monthName %></div>
                      <% if (day.isToday) { %>
                        <div class="mini-cal-today-dot"></div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>

                <button type="button" class="mini-cal-nav-btn next" onclick="navigateMiniCal(1)" title="เลื่อนดูวันถัดไป">
                  &#8250;
                </button>
              </div>
            </div>

            <!-- ฟอร์มและช่วงเวลา (Interactive Time Range Grid) -->
            <form action="/app/bookings" method="POST" enctype="multipart/form-data" id="bookingMainForm" onsubmit="return validateAttendees();">
              <input type="hidden" name="booking_date" id="form_booking_date" value="<%= selectedDate %>">
              
              <!-- เลือกระบุห้องในตึกนี้ -->
              <input type="hidden" name="room_id" id="form_room_id" required>

              <!-- Interactive Time Range Selector -->
              <div style="margin-bottom: 1.25rem;">
                <div style="margin-bottom: 0.5rem;">
                  <label style="font-size: 0.85rem; font-weight: 700; color: var(--dark); margin: 0;">
                    เลือกช่วงเวลา (แตะเวลาเริ่ม แล้วแตะเวลาสิ้นสุด):
                  </label>
                </div>

                <!-- คำแนะนำการเลือกเวลา (Guide Pill) -->
                <div id="slotGuidePill" class="conflict-status-banner is-free" style="margin-bottom: 0.75rem; text-align: center;">
                  แตะช่องเวลาเพื่อกำหนดเวลาเริ่มต้น
                </div>

                <!-- Grid สล็อตเวลา 09:00 - 18:00 (Hourly Buttons) -->
                <div class="time-range-picker-grid" id="timeRangeGrid">
                  <% for (let h = 9; h <= 18; h++) { 
                    const hourStr = `${String(h).padStart(2, '0')}:00`;
                  %>
                    <div class="time-slot-pill" data-hour="<%= h %>" data-time="<%= hourStr %>" onclick="onTimeRangePillClick(<%= h %>)">
                      <%= hourStr %>
                    </div>
                  <% } %>
                </div>

                <!-- Input selects สำหรับเวลาเริ่มต้นและสิ้นสุด -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem;">
                  <div>
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">เวลาเริ่มต้น:</label>
                    <select name="start_time_str" id="form_start_time" class="form-control" onchange="onStartTimeChange()" required style="height: 38px; font-weight: 700;">
                      <% for (let h = 9; h < 18; h++) { 
                        const hourStr = `${String(h).padStart(2, '0')}:00`;
                      %>
                        <option value="<%= hourStr %>"><%= hourStr %> น.</option>
                      <% } %>
                    </select>
                  </div>
                  <div>
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">เวลาสิ้นสุด:</label>
                    <select name="end_time_str" id="form_end_time" class="form-control" onchange="checkBookingConflict()" required style="height: 38px; font-weight: 700;">
                      <% for (let h = 10; h <= 18; h++) { 
                        const hourStr = `${String(h).padStart(2, '0')}:00`;
                      %>
                        <option value="<%= hourStr %>"><%= hourStr %> น.</option>
                      <% } %>
                    </select>
                  </div>
                </div>

                <div id="conflictStatusBanner" class="conflict-status-banner is-free" style="margin-top: 0.75rem;">
                  <span>ช่วงเวลานี้ว่าง สามารถทำรายการจองได้</span>
                </div>
              </div>

              <hr style="border: none; border-top: 1px dashed var(--border); margin: 1.25rem 0;">

              <!-- Step 2: รายละเอียดการประชุม -->
              <div style="font-size: 0.95rem; font-weight: 800; color: var(--dark); margin-bottom: 0.85rem;">
                Step 2: รายละเอียดการประชุม
              </div>

              <div class="form-group" style="margin-bottom: 0.85rem;">
                <label for="form_title" style="font-size: 0.82rem; font-weight: 700;">หัวข้อการประชุม / กิจกรรม *</label>
                <input type="text" name="title" id="form_title" class="form-control" placeholder="เช่น ประชุมสรุปงานประจำสัปดาห์, วางแผนการตลาด" required>
              </div>

              <div class="form-group" style="margin-bottom: 0.85rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                  <label for="form_attendees" style="font-size: 0.82rem; font-weight: 700; margin: 0;">จำนวนผู้เข้าร่วม (คน) *</label>
                  <span style="font-size: 0.75rem; color: var(--muted);">
                    (ความจุห้องนี้สูงสุด: <strong id="attendeesMaxDisplay" style="color: #2563eb;"><%= rooms[0] ? rooms[0].capacity : 20 %></strong> คน)
                  </span>
                </div>
                <input type="number" name="attendees_count" id="form_attendees" class="form-control" value="5" min="1" max="<%= rooms[0] ? rooms[0].capacity : 20 %>" oninput="validateAttendees()" required>
                <small id="attendeesErrorMsg" style="color: var(--danger); font-size: 0.75rem; display: none; margin-top: 0.35rem; font-weight: 600;"></small>
              </div>

              <div class="form-group" style="margin-bottom: 0.85rem;">
                <label for="form_purpose" style="font-size: 0.82rem; font-weight: 700;">วัตถุประสงค์ / อุปกรณ์เสริม (ถ้ามี)</label>
                <textarea name="purpose" id="form_purpose" class="form-control" rows="2" placeholder="ระบุสิ่งที่ต้องการเพิ่มเติม เช่น ขอไมโครโฟนไร้สาย 2 ตัว"></textarea>
              </div>

              <div class="form-group" style="margin-bottom: 1.25rem;">
                <label for="form_agenda" style="font-size: 0.82rem; font-weight: 700;">แนบเอกสารวาระหรือผังประชุม (ถ้ามี)</label>
                <input type="file" name="agenda_file" id="form_agenda" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                <span style="font-size: 0.72rem; color: var(--muted); display: block; margin-top: 0.25rem;">
                  รองรับไฟล์ PDF, JPG, PNG (ขนาดไม่เกิน 5 MB)
                </span>
              </div>

              <div style="display: flex; gap: 0.75rem; justify-content: flex-end; align-items: center;">
                <button type="button" class="btn btn-outline" onclick="switchRequesterView('home')">
                  ย้อนกลับ
                </button>
                <button type="submit" id="submitBookingBtn" class="btn btn-primary" style="padding: 0.75rem 1.75rem; font-weight: 800; font-size: 0.95rem;">
                  ยืนยันการจองห้อง
                </button>
              </div>
            </form>
          </div>

        </div>
        <% } %>

        <% if (canViewOwnBookings) { %>
        <!-- ================= SUBVIEW 3: ส่วนตารางคำขอของฉัน (My Bookings Modern Card) ================= -->
        <div id="req-view-mybookings" class="req-subview" style="display: none;">
          <div class="card my-bookings-card" style="margin-top: 0.5rem;">
            <%
              const pendingCount = myBookings.filter(b => b.status === 'PENDING_APPROVAL').length;
              const approvedCount = myBookings.filter(b => b.status === 'APPROVED').length;
              const inUseCount = myBookings.filter(b => b.status === 'IN_USE').length;
              const activeCount = pendingCount + approvedCount + inUseCount;
              const completedCount = myBookings.filter(b => b.status === 'COMPLETED').length;
              const rejectCount = myBookings.filter(b => ['REJECTED', 'CANCELLED'].includes(b.status)).length;
              const finishedCount = completedCount + rejectCount;
            %>
            
            <!-- Header: จัดวางหัวข้อการ์ดและ Segmented Filter Bar สไตล์โมเดิร์น -->
            <div class="my-bookings-header">
              <div class="my-bookings-title-area">
                <div class="my-bookings-heading">
                  <h3 class="my-bookings-title">รายการคำขอของฉัน</h3>
                  <span class="my-bookings-total-pill">
                    <span id="myBookingsTotalCount"><%= myBookings.length %></span> รายการ
                  </span>
                </div>
                <div class="my-bookings-subtitle">
                  แสดงประวัติและสถานะการพิจารณาคำขอจองห้องประชุมของคุณ
                </div>
              </div>

              <% if (myBookings.length > 0) { %>
                <!-- Modern Segmented Control Bar -->
                <div class="segmented-control-container" role="tablist" aria-label="กรองสถานะคำขอ">
                  <button type="button" class="segmented-item active" data-category="PENDING" onclick="filterMyBookings('PENDING', this)" title="รายการที่รอหัวหน้างานอนุมัติ">
                    <span class="segmented-label">กำลังดำเนินการ</span>
                    <span class="segmented-badge <%= pendingCount > 0 ? 'badge-pending' : '' %>"><%= pendingCount %></span>
                  </button>
                  <button type="button" class="segmented-item" data-category="APPROVED" onclick="filterMyBookings('APPROVED', this)" title="อนุมัติแล้ว และพร้อมใช้งาน">
                    <span class="segmented-label">อนุมัติแล้ว</span>
                    <span class="segmented-badge <%= approvedCount > 0 ? 'badge-approved' : '' %>"><%= approvedCount %></span>
                  </button>
                  <button type="button" class="segmented-item" data-category="FINISHED" onclick="filterMyBookings('FINISHED', this)" title="ประวัติที่สิ้นสุดแล้ว (เสร็จสิ้น/ยกเลิก/ปฏิเสธ)">
                    <span class="segmented-label">เสร็จสิ้น</span>
                    <span class="segmented-badge"><%= finishedCount %></span>
                  </button>
                </div>
              <% } %>
            </div>

            <% if (myBookings.length === 0) { %>
              <div class="empty-state">
                <div class="empty-state-icon" style="opacity: 0.4;">—</div>
                <div class="empty-state-title">ยังไม่มีรายการจองห้องประชุม</div>
                <div class="empty-state-desc">คุณยังไม่ได้ทำรายการจองห้องใดๆ สามารถเริ่มจองห้องได้ทันทีที่แท็บ "จองห้อง"</div>
                <button type="button" class="btn btn-primary" onclick="switchRequesterView('booking')" style="margin-top: 1rem;">
                  เริ่มจองห้องตอนนี้
                </button>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="clean-table">
                  <thead>
                    <tr>
                      <th style="width: 28%;">ห้องประชุม & วันที่/เวลา</th>
                      <th style="width: 36%;">หัวข้อการประชุม</th>
                      <th style="width: 22%;">สถานะ</th>
                      <th style="width: 14%; text-align: center;">จัดการ</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% myBookings.forEach(b => { 
                      const bDate = new Date(b.start_time).toLocaleDateString('th-TH');
                      const bStartTime = new Date(b.start_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                      const bEndTime = new Date(b.end_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                      
                      let groupCategory = 'REJECT';
                      let isFinished = false;
                      if (b.status === 'PENDING_APPROVAL') groupCategory = 'PENDING';
                      else if (b.status === 'APPROVED') groupCategory = 'APPROVED';
                      else if (b.status === 'IN_USE') groupCategory = 'IN_USE';
                      else if (b.status === 'COMPLETED') { groupCategory = 'COMPLETED'; isFinished = true; }
                      else if (['REJECTED', 'CANCELLED'].includes(b.status)) { groupCategory = 'REJECT'; isFinished = true; }
                    %>
                      <tr class="my-booking-row" data-category="<%= groupCategory %>" data-finished="<%= isFinished ? 'true' : 'false' %>">
                        <td>
                          <div style="font-weight: 700; color: var(--dark); font-size: 0.95rem;">
                            <%= b.room_name || ('ห้อง ' + b.room_id) %>
                          </div>
                          <div style="font-size: 0.8rem; color: var(--muted); margin-top: 0.2rem;">
                            <%= bDate %> &bull; <%= bStartTime %> - <%= bEndTime %> น.
                          </div>
                        </td>
                        <td>
                          <div style="font-weight: 700; color: var(--dark); font-size: 0.92rem;"><%= b.title %></div>
                          <% if (b.purpose) { %>
                            <div style="font-size: 0.78rem; color: var(--muted); margin-top: 0.15rem;"><%= b.purpose %></div>
                          <% } %>
                          <% if (b.attachment_id) { %>
                            <button type="button" class="btn btn-outline btn-xs" onclick="openFilePreview('<%= b.attachment_id %>', '<%= b.file_name %>')" style="margin-top: 0.35rem; font-size: 0.72rem; padding: 2px 7px; display: inline-flex; align-items: center; gap: 0.25rem;">
                              ดูเอกสารแนบ
                            </button>
                          <% } %>
                        </td>
                        <td>
                          <span class="status-badge status-<%= b.status %>"><%= b.status %></span>
                          <% if (b.status === 'REJECTED') { %>
                            <div style="color: var(--danger); font-size: 0.78rem; margin-top: 0.25rem; font-weight: 500;">
                              ไม่อนุมัติ: <%= b.approver_comment || 'ไม่มีการระบุเหตุผล' %>
                            </div>
                          <% } else if (b.status === 'CANCELLED') { %>
                            <div style="color: var(--muted); font-size: 0.78rem; margin-top: 0.2rem;">
                              ยกเลิกแล้ว
                            </div>
                          <% } else if (b.status === 'IN_USE') { %>
                            <div style="color: var(--primary); font-size: 0.78rem; margin-top: 0.2rem; font-weight: 600;">
                              เจ้าหน้าที่ส่งมอบห้องแล้ว
                            </div>
                          <% } else if (b.status === 'COMPLETED' && b.facility_comment) { %>
                            <div style="color: var(--muted); font-size: 0.78rem; margin-top: 0.2rem;">
                              <%= b.facility_comment %>
                            </div>
                          <% } %>
                        </td>
                        <td style="text-align: center;">
                          <% if (b.status === 'PENDING_APPROVAL') { %>
                            <form action="/app/bookings/<%= b.booking_id %>/cancel" method="POST" onsubmit="return confirm('ยืนยันยกเลิกคำขอจองห้องนี้?');" style="display:inline;">
                              <button class="btn btn-danger btn-xs" style="padding: 0.25rem 0.6rem;">ยกเลิก</button>
                            </form>
                          <% } else { %>
                            <span style="color: var(--muted); font-size: 0.8rem;">-</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                    <tr id="myBookingsEmptyFilterRow" style="display: none;">
                      <td colspan="4" style="text-align: center; padding: 3rem 1.5rem; color: var(--muted);">
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;">
                          <div id="myBookingsEmptyTitle" style="font-weight: 600; color: var(--slate); font-size: 0.95rem;">ไม่มีรายการคำขอที่กำลังดำเนินการ</div>
                          <div id="myBookingsEmptyDesc" style="font-size: 0.82rem; color: var(--muted);">ไม่มีคำขอที่อยู่ระหว่างรอการอนุมัติในขณะนี้</div>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
        <% } %>


        <!-- ================= SUBVIEW 4: โปรไฟล์ผู้ใช้ (User Profile & Switcher) ================= -->
        <div id="req-view-profile" class="req-subview" style="display: none;">
          <div class="card" style="margin-top: 0.5rem; text-align: center; padding: 2rem 1.5rem;">
            <div style="width: 72px; height: 72px; border-radius: 50%; background: #2563eb; color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; margin: 0 auto 1rem auto; box-shadow: 0 4px 12px rgba(37,99,235,0.3);">
              <%= user.fullName ? user.fullName.charAt(0) : 'U' %>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--dark); margin: 0 0 0.25rem 0;"><%= user.fullName %></h3>
            <p style="color: var(--muted); font-size: 0.85rem; margin: 0 0 0.75rem 0;">ชื่อผู้ใช้: <strong><%= user.username %></strong> &bull; สังกัด: <%= user.department || 'สำนักงานใหญ่' %></p>
            <span class="role-pill" style="font-size: 0.8rem; padding: 0.25rem 0.85rem;"><%= user.roleDisplay %></span>

            <hr style="border: none; border-top: 1px solid var(--border); margin: 1.75rem 0;">

            <div style="text-align: left; margin-bottom: 1.5rem;">
              <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--dark); margin-bottom: 0.75rem;">ตั้งค่าทั่วไป</h4>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px dashed var(--border);">
                <div>
                  <div style="font-weight: 600; font-size: 0.85rem; color: var(--dark);">ธีมการแสดงผล</div>
                  <div style="font-size: 0.75rem; color: var(--muted);">สลับระหว่างโหมดมืด (Dark Mode) และโหมดสว่าง</div>
                </div>
                <button type="button" class="btn btn-outline btn-sm" onclick="toggleTheme()">สลับธีม</button>
              </div>
            </div>

            <!-- แก้ไขข้อมูลส่วนตัว (Edit Personal Info - All Roles) -->
            <div style="text-align: left; margin-bottom: 1.5rem; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem;">
              <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--dark); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                แก้ไขข้อมูลส่วนตัว (Profile Settings)
              </h4>
              <form action="/app/profile/update" method="POST">
                <div class="form-group" style="margin-bottom: 0.75rem;">
                  <label style="font-size: 0.8rem; font-weight: 600; color: var(--dark); display: block; margin-bottom: 0.25rem;">ชื่อ-นามสกุล:</label>
                  <input type="text" name="full_name" class="form-control" value="<%= user.fullName || '' %>" required style="font-size: 0.85rem;">
                </div>
                <div class="form-group" style="margin-bottom: 0.75rem;">
                  <label style="font-size: 0.8rem; font-weight: 600; color: var(--dark); display: block; margin-bottom: 0.25rem;">แผนก / สังกัด:</label>
                  <input type="text" name="department" class="form-control" value="<%= user.department || '' %>" placeholder="เช่น แผนกเทคโนโลยีสารสนเทศ" style="font-size: 0.85rem;">
                </div>
                <div style="border-top: 1px dashed var(--border); margin: 1rem 0; padding-top: 0.75rem;">
                  <div style="font-size: 0.8rem; font-weight: 600; color: var(--dark); margin-bottom: 0.5rem;">เปลี่ยนรหัสผ่าน (เว้นว่างไว้หากไม่ต้องการเปลี่ยน):</div>
                  <div class="form-group" style="margin-bottom: 0.75rem;">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.25rem;">รหัสผ่านเดิม (จำเป็นหากต้องการเปลี่ยนรหัสผ่านใหม่):</label>
                    <input type="password" name="current_password" class="form-control" placeholder="••••••••" style="font-size: 0.85rem;">
                  </div>
                  <div class="form-group" style="margin-bottom: 0.75rem;">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.25rem;">รหัสผ่านใหม่:</label>
                    <input type="password" name="new_password" class="form-control" placeholder="รหัสผ่านใหม่อย่างน้อย 6 ตัวอักษร" minlength="6" style="font-size: 0.85rem;">
                  </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="width: 100%; font-weight: 700; padding: 0.6rem;">
                  บันทึกข้อมูลส่วนตัว
                </button>
              </form>
            </div>

            <!-- สลับบทบาททดสอบด่วน -->
            <div style="text-align: left; margin-bottom: 1.5rem;">
              <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--dark); margin-bottom: 0.75rem;">สลับบทบาททดสอบ (Demo Switcher)</h4>
              <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem;">
                <form action="/login" method="POST" style="margin: 0;">
                  <input type="hidden" name="username" value="somchai">
                  <input type="hidden" name="password" value="user123">
                  <button type="submit" class="btn btn-outline btn-sm" style="width: 100%;">ผู้ใช้งานทั่วไป (somchai)</button>
                </form>
                <form action="/login" method="POST" style="margin: 0;">
                  <input type="hidden" name="username" value="manager">
                  <input type="hidden" name="password" value="approver123">
                  <button type="submit" class="btn btn-outline btn-sm" style="width: 100%;">หัวหน้างาน (manager)</button>
                </form>
                <form action="/login" method="POST" style="margin: 0;">
                  <input type="hidden" name="username" value="facility">
                  <input type="hidden" name="password" value="facility123">
                  <button type="submit" class="btn btn-outline btn-sm" style="width: 100%;">เจ้าหน้าที่ (facility)</button>
                </form>
                <form action="/login" method="POST" style="margin: 0;">
                  <input type="hidden" name="username" value="admin">
                  <input type="hidden" name="password" value="admin123">
                  <button type="submit" class="btn btn-outline btn-sm" style="width: 100%;">แอดมิน (admin)</button>
                </form>
              </div>
            </div>

            <% if (user.roleName === 'admin' || isAdmin) { %>
              <div style="text-align: left; margin-bottom: 1.5rem;">
                <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--dark); margin-bottom: 0.75rem;">เมนูผู้ดูแลระบบ (Admin Shortcuts)</h4>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem;">
                  <a href="/admin/acl" class="btn btn-outline btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 0.35rem; color: #4f46e5; font-weight: 700; text-decoration: none;">
                    จัดการสิทธิ์ ACL
                  </a>
                  <a href="/admin/logs" class="btn btn-outline btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 0.35rem; text-decoration: none;">
                    Audit Logs
                  </a>
                  <a href="/admin/users" class="btn btn-outline btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 0.35rem; text-decoration: none;">
                    จัดการผู้ใช้งาน
                  </a>
                  <a href="/app/rooms" class="btn btn-outline btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 0.35rem; text-decoration: none;">
                    จัดการห้องประชุม
                  </a>
                </div>
              </div>
            <% } %>

            <form action="/logout" method="POST" style="margin: 0;">
              <button type="submit" class="btn btn-danger" style="width: 100%; padding: 0.75rem; font-weight: 700;">
                ออกจากระบบ
              </button>
            </form>
          </div>
        </div>

        <!-- ================= SUBVIEWS 5-7 (Approvals, Facility, Timeline) ================= -->
<% if (canApprove || isAdminUser) { %>
      <div id="req-view-approvals" class="req-subview" style="display: none;">
        <div class="card" style="margin-bottom: 1rem; border-left: 4px solid #f59e0b;">
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin: 0 0 0.35rem 0;">
            คิวงานรอการพิจารณาอนุมัติ (<%= pendingApprovals.length %>)
          </h3>
          <p style="font-size: 0.82rem; color: var(--muted); margin: 0;">
            ตรวจสอบรายละเอียดคำขอ อุปกรณ์ที่ต้องการ และเอกสารแนบเพื่อพิจารณาอนุมัติ
          </p>
        </div>
        <div class="card" style="border-left: 4px solid var(--primary);">
          <div class="card-title">คำขอที่รอการพิจารณาอนุมัติ (<%= pendingApprovals.length %>)</div>
          
          <% if (pendingApprovals.length === 0) { %>
            <div style="text-align: center; padding: 2.5rem; color: var(--muted);">
              ไม่มีรายการรออนุมัติในขณะนี้ ทุกคำขอได้รับการจัดการแล้ว
            </div>
          <% } else { %>
            <div style="display: grid; gap: 1rem;">
              <% pendingApprovals.forEach(p => { %>
                <div class="approval-item-card">
                  <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 0.5rem;">
                    <div>
                      <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--dark); margin-bottom: 0.25rem;">
                        <%= p.title %>
                      </h4>
                      <p style="color: var(--slate); font-size: 0.85rem; margin-bottom: 0.35rem;">
                        <strong>ห้อง:</strong> <%= p.room_name %> | <strong>ผู้ขอ:</strong> <%= p.requester_name %> (<%= p.department || 'ไม่ระบุ' %>)
                      </p>
                      <p style="color: var(--muted); font-size: 0.8rem;">
                        <strong>วันเวลา:</strong> <%= new Date(p.start_time).toLocaleDateString('th-TH') %> 
                        (<%= new Date(p.start_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> - 
                        <%= new Date(p.end_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %>)
                      </p>
                      <% if (p.purpose) { %>
                        <div class="approval-purpose-box">
                          <strong>รายละเอียด/อุปกรณ์เสริม:</strong> <%= p.purpose %>
                        </div>
                      <% } %>
                    </div>

                    <% if (p.attachment_id) { %>
                      <button type="button" class="btn btn-outline btn-sm" onclick="openFilePreview('<%= p.attachment_id %>', '<%= p.file_name %>')">
                        ตรวจเอกสารแนบ
                      </button>
                    <% } %>
                  </div>

                  <div style="display: flex; gap: 0.75rem; margin-top: 1rem; border-top: 1px solid var(--border); padding-top: 0.75rem;">
                    <form action="/app/bookings/<%= p.booking_id %>/review" method="POST" style="flex: 1;">
                      <input type="hidden" name="action" value="APPROVE">
                      <button class="btn btn-success" style="width: 100%; font-size: 0.85rem;">
                        อนุมัติการจอง (Approve)
                      </button>
                    </form>
                    <button type="button" class="btn btn-danger btn-open-reject" 
                            style="flex: 1; font-size: 0.85rem;"
                            data-booking-id="<%= p.booking_id %>"
                            data-title="<%= p.title %>"
                            data-requester="<%= p.requester_name %>">
                      ปฏิเสธ (Reject)
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <!-- Safety Rollback Box -->
          <% 
            const approvedList = dayBookings.filter(b => b.status === 'APPROVED');
          %>
          <% if (approvedList.length > 0) { %>
            <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px dashed var(--border);">
              <h4 class="rollback-section-title" style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem;">
                Safety Rollback (ยกเลิกการอนุมัติก่อน Check-in)
              </h4>
              <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 0.75rem;">
                กรณีเปลี่ยนใจหรือกดผิด สามารถกดยกเลิกการอนุมัติเพื่อดึงคำขอกลับมาพิจารณาใหม่ได้
              </p>
              <div style="display: grid; gap: 0.5rem;">
                <% approvedList.forEach(item => { %>
                  <div class="rollback-item-card">
                    <div>
                      <strong><%= item.title %></strong> (<%= item.room_name %>)<br>
                      <small style="color: var(--muted);"><%= item.requester_name %></small>
                    </div>
                    <form action="/app/bookings/<%= item.booking_id %>/revoke" method="POST" onsubmit="return confirm('ยืนยันดึงคำขอนี้กลับมาเป็น PENDING_APPROVAL?');">
                      <button class="btn btn-outline btn-sm rollback-revoke-btn" style="font-size: 0.75rem;">
                        ดึงสถานะกลับ
                      </button>
                    </form>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- ================= TAB 4: คิวงานส่งมอบห้อง & ตรวจรับ (Facility Tasks) ================= -->
    <% if (canFacility) { %>
      <div id="req-view-facility" class="req-subview" style="display: none;">
        <div class="card" style="margin-bottom: 1rem; border-left: 4px solid var(--success);">
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin: 0 0 0.35rem 0;">
            คิวงานส่งมอบห้อง & ตรวจรับ (<%= facilityTasks.length %>)
          </h3>
          <p style="font-size: 0.82rem; color: var(--muted); margin: 0;">
            ส่งมอบห้อง (Check-in) และตรวจสภาพความพร้อมของห้องหลังใช้งาน (Check-out)
          </p>
        </div>

        <div class="card" style="border-left: 4px solid var(--success);">
          <div class="card-title">รายการงานส่งมอบ & ตรวจสภาพห้อง (<%= facilityTasks.length %>)</div>
          <% if (facilityTasks.length === 0) { %>
            <div style="text-align: center; padding: 2.5rem; color: var(--muted); font-size: 0.9rem;">
              <div style="font-size: 1.8rem; margin-bottom: 0.5rem; opacity: 0.6;">✨</div>
              ไม่มีคิวงานส่งมอบหรือตรวจรับห้องในขณะนี้ ทุกห้องพร้อมใช้งานเรียบร้อย
            </div>
          <% } else { %>
            <div style="display: grid; gap: 0.85rem;">
              <% facilityTasks.forEach(t => { %>
                <div class="facility-task-card">
                  <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.75rem; flex-wrap: wrap;">
                    <div>
                      <strong style="font-size: 1.05rem; color: var(--dark);"><%= t.title %></strong>
                      <div style="font-size: 0.85rem; color: var(--slate); margin-top: 0.2rem;">
                        <strong>ห้อง:</strong> <%= t.room_name %> &bull; <strong>ผู้ขอ:</strong> <%= t.requester_name %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--muted); margin-top: 0.15rem;">
                        ⏰ <%= new Date(t.start_time).toLocaleDateString('th-TH') %> 
                        (<%= new Date(t.start_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> - 
                        <%= new Date(t.end_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> น.)
                      </div>
                    </div>
                    <span class="status-badge status-<%= t.status %>"><%= t.status %></span>
                  </div>

                  <% if (t.attachment_id) { %>
                    <div style="margin: 0.65rem 0;">
                      <button type="button" class="btn btn-outline btn-xs" onclick="openFilePreview('<%= t.attachment_id %>', '<%= t.file_name %>')" style="display: inline-flex; align-items: center; gap: 0.3rem;">
                        ดูผังจัดห้อง / วาระการประชุม
                      </button>
                    </div>
                  <% } %>

                  <div style="margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px dashed var(--border);">
                    <% if (t.status === 'APPROVED') { %>
                      <form action="/app/facility/checkin/<%= t.booking_id %>" method="POST" style="margin: 0;">
                        <button class="btn btn-primary btn-sm" style="width: 100%; font-weight: 700; padding: 0.6rem;">
                          ส่งมอบห้อง & เปิดระบบ (Check-in)
                        </button>
                      </form>
                    <% } else if (t.status === 'IN_USE') { %>
                      <form action="/app/facility/checkout/<%= t.booking_id %>" method="POST" enctype="multipart/form-data" style="margin: 0;">
                        <div class="form-group" style="margin-bottom: 0.65rem;">
                          <label style="font-size: 0.8rem; font-weight: 700; color: var(--dark);">ถ่ายรูปตรวจสภาพห้องหลังใช้ (Inspection Photo):</label>
                          <input type="file" name="inspection_file" class="form-control" style="font-size: 0.8rem;" accept="image/*,.pdf">
                        </div>
                        <button class="btn btn-success btn-sm" style="width: 100%; font-weight: 700; padding: 0.6rem;">
                          ตรวจสภาพเรียบร้อย & ปิดงาน (Check-out)
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- ================= TAB: บล็อกปิดห้องซ่อมบำรุง (Maintenance / Block Schedule) ================= -->
    <% if (canBlockSchedule) { %>
      <div id="req-view-facility-block" class="req-subview" style="display: none;">
        <div class="card" style="margin-bottom: 1rem; border-left: 4px solid var(--warning);">
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin: 0 0 0.35rem 0;">
            บล็อกปิดห้องซ่อมบำรุง & งานพิเศษ
          </h3>
          <p style="font-size: 0.82rem; color: var(--muted); margin: 0;">
            ระงับการจองห้องชั่วคราวสำหรับงานช่าง ซ่อมบำรุงระบบ หรือจัดกิจกรรมเฉพาะกิจส่วนกลาง
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem;">
          <!-- ฟอร์มบล็อกปิดห้องซ่อมบำรุง -->
          <div class="card" style="border-left: 4px solid var(--warning);">
            <div class="card-title" style="display: flex; align-items: center; gap: 0.4rem;">
              <span>🛠️</span> แบบฟอร์มระงับการใช้งานห้อง
            </div>
            <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 1rem;">
              เมื่อระงับการใช้งานแล้ว ปฏิทินจะขึ้นแถบสีเทาและไม่อนุญาตให้พนักงานจองช่วงเวลานี้
            </p>

            <form action="/app/facility/block" method="POST">
              <div class="form-group" style="margin-bottom: 0.85rem;">
                <label for="block_date_input" style="font-size: 0.82rem; font-weight: 700;">วันที่ต้องการบล็อก *</label>
                <input type="date" name="block_date" id="block_date_input" class="form-control" value="<%= selectedDate %>" min="<%= todayStr %>" required>
              </div>

              <div class="form-group" style="margin-bottom: 0.85rem;">
                <label for="block_room_id" style="font-size: 0.82rem; font-weight: 700;">เลือกห้องที่จะบล็อก *</label>
                <select name="room_id" id="block_room_id" class="form-control" required style="font-weight: 600;">
                  <% rooms.forEach(r => { %>
                    <option value="<%= r.room_id %>"><%= r.room_name %> (<%= r.location %>)</option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group" style="margin-bottom: 0.85rem;">
                <label for="reason" style="font-size: 0.82rem; font-weight: 700;">เหตุผลที่ปิดห้อง *</label>
                <input type="text" name="reason" id="reason" class="form-control" placeholder="เช่น ช่างเข้าซ่อมระบบแอร์ / งานสัมมนาใหญ่" required>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="b_start" style="font-size: 0.82rem; font-weight: 700;">ตั้งแต่เวลา</label>
                  <input type="time" name="start_time_str" id="b_start" class="form-control" value="08:00" required>
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="b_end" style="font-size: 0.82rem; font-weight: 700;">ถึงเวลา</label>
                  <input type="time" name="end_time_str" id="b_end" class="form-control" value="12:00" required>
                </div>
              </div>

              <button type="submit" class="btn btn-danger" style="width: 100%; font-weight: 800; padding: 0.75rem;">
                บล็อกช่วงเวลานี้ทันที
              </button>
            </form>
          </div>

          <!-- รายการห้องที่ปิดซ่อมในวันนี้ -->
          <div class="card" style="border-left: 4px solid var(--slate);">
            <div class="card-title" style="display: flex; align-items: center; justify-content: space-between;">
              <span style="display: flex; align-items: center; gap: 0.4rem;">
                <span>📋</span> รายการที่ปิดซ่อมในวันที่เลือก
              </span>
              <span style="font-size: 0.78rem; color: var(--muted);"><%= selectedDate %></span>
            </div>

            <% 
              const blockedBookingsToday = dayBookings.filter(b => b.status === 'BLOCKED');
            %>
            <% if (blockedBookingsToday.length === 0) { %>
              <div style="text-align: center; padding: 2.5rem; color: var(--muted); font-size: 0.88rem;">
                <div style="font-size: 1.8rem; margin-bottom: 0.5rem; opacity: 0.6;">✅</div>
                ไม่มีรายการบล็อกปิดซ่อมในวันที่เลือก<br>
                ทุกห้องเปิดให้ใช้งานตามปกติ
              </div>
            <% } else { %>
              <div style="display: grid; gap: 0.75rem;">
                <% blockedBookingsToday.forEach(b => { 
                  const bStart = new Date(b.start_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                  const bEnd = new Date(b.end_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                %>
                  <div style="padding: 0.85rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg);">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.35rem;">
                      <strong style="color: var(--dark); font-size: 0.95rem;"><%= b.room_name %></strong>
                      <span class="status-badge status-BLOCKED" style="font-size: 0.7rem; padding: 2px 7px;">BLOCKED</span>
                    </div>
                    <div style="font-size: 0.82rem; color: var(--slate); margin-bottom: 0.2rem;">
                      ⏰ <%= bStart %> - <%= bEnd %> น.
                    </div>
                    <div style="font-size: 0.78rem; color: var(--muted);">
                      <strong>เหตุผล:</strong> <%= b.title || 'ปิดซ่อมบำรุง' %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- ================= TAB 5: ไทม์ไลน์ภาพรวม (Time Slots Matrix) ================= -->
    <% if (isAdminUser) { %>
      <div id="req-view-timeline" class="req-subview" style="display: none;">
        <div class="card" style="margin-bottom: 1rem; border-left: 4px solid #6366f1;">
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin: 0 0 0.35rem 0;">
            แผนผังช่วงเวลาห้องประชุม (Time Slots Matrix)
          </h3>
          <p style="font-size: 0.82rem; color: var(--muted); margin: 0;">
            ตารางแสดงสถานะความว่างของห้องประชุมทุก 30 นาที สำหรับผู้ดูแลระบบ
          </p>
        </div>
        <div class="card">
          <div class="card-title" style="margin-bottom: 0.5rem;">
            แผนผังช่วงเวลาความว่างของห้องประชุม (30-Minute Time Slots)
          </div>
          <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 1rem;">
            ตารางแสดงสถานะความว่างทุก 30 นาที สำหรับผู้ดูแลระบบ
          </p>

          <% 
            const timeSlots = [];
            for (let h = 8; h < 18; h++) {
              const hStr = String(h).padStart(2, '0');
              timeSlots.push(`${hStr}:00`);
              timeSlots.push(`${hStr}:30`);
            }
          %>

          <% rooms.forEach(room => { %>
            <div class="room-slot-row">
              <div class="room-slot-info">
                <strong style="font-size: 0.85rem; color: var(--dark);"><%= room.room_name %></strong><br>
                <small style="color: var(--muted); font-size: 0.7rem;">จุ <%= room.capacity %> คน</small>
              </div>
              <div class="slots-container">
                <% timeSlots.forEach(slotTime => { 
                  const slotDateTime = new Date(`${selectedDate}T${slotTime}:00`);
                  let slotStatus = 'FREE';
                  let bookingInfo = '';

                  dayBookings.forEach(b => {
                    if (b.room_id === room.room_id) {
                      const bStart = new Date(b.start_time);
                      const bEnd = new Date(b.end_time);
                      if (slotDateTime >= bStart && slotDateTime < bEnd) {
                        if (b.status === 'BLOCKED') slotStatus = 'BLOCKED';
                        else if (b.status === 'PENDING_APPROVAL') slotStatus = 'PENDING';
                        else if (['APPROVED', 'IN_USE'].includes(b.status)) slotStatus = 'BOOKED';
                        bookingInfo = b.title;
                      }
                    }
                  });
                %>
                  <% if (slotStatus === 'FREE') { %>
                    <div class="slot-block slot-free" 
                         title="ว่าง: คลิกเพื่อเลือกเวลานี้ (<%= slotTime %>)"
                         onclick="selectRoomAndSlot('<%= room.room_id %>', '<%= slotTime %>', '<%= slotTime.split(':')[0] %>:59')">
                      <span><%= slotTime %></span>
                      <span style="font-size: 0.55rem;">ว่าง</span>
                    </div>
                  <% } else if (slotStatus === 'PENDING') { %>
                    <div class="slot-block slot-pending" title="รออนุมัติ: <%= bookingInfo %>">
                      <span><%= slotTime %></span>
                      <span style="font-size: 0.55rem;">รอตรวจ</span>
                    </div>
                  <% } else if (slotStatus === 'BOOKED') { %>
                    <div class="slot-block slot-booked" title="ติดจอง: <%= bookingInfo %>">
                      <span><%= slotTime %></span>
                      <span style="font-size: 0.55rem;">ติดจอง</span>
                    </div>
                  <% } else if (slotStatus === 'BLOCKED') { %>
                    <div class="slot-block slot-blocked" title="ปิดซ่อม: <%= bookingInfo %>">
                      <span><%= slotTime %></span>
                      <span style="font-size: 0.55rem;">ปิดซ่อม</span>
                    </div>
                  <% } %>
                <% }) %>
              </div>
            </div>
          <% }) %>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; font-size: 0.8rem; border-top: 1px solid var(--border); padding-top: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.35rem;"><div style="width: 12px; height: 12px; border-radius: 3px; background: #ecfdf5; border: 1px solid #a7f3d0;"></div> ว่าง</div>
            <div style="display: flex; align-items: center; gap: 0.35rem;"><div style="width: 12px; height: 12px; border-radius: 3px; background: #fef3c7; border: 1px solid #fde68a;"></div> รออนุมัติ</div>
            <div style="display: flex; align-items: center; gap: 0.35rem;"><div style="width: 12px; height: 12px; border-radius: 3px; background: #e0e7ff; border: 1px solid #c7d2fe;"></div> อนุมัติแล้ว / ใช้งาน</div>
            <div style="display: flex; align-items: center; gap: 0.35rem;"><div style="width: 12px; height: 12px; border-radius: 3px; background: #f1f5f9; border: 1px solid #cbd5e1;"></div> บล็อกปิดซ่อม (Blocked)</div>
          </div>
        </div>
      </div>
    <% } %>

  </div>
      </div> <!-- ปิด .requester-view-container -->
    </div> <!-- ปิด .container -->

  <script>
    // ข้อมูลการจองและห้องของวันที่เลือกสำหรับการตรวจสอบแบบ Real-time
    const DAY_BOOKINGS = <%- JSON.stringify(dayBookings) %>;
    const ROOMS = <%- JSON.stringify(rooms) %>;
    let toastTimer = null;

    // สลับแท็บ (Alias เข้าหา switchRequesterView เพื่อความเข้ากันได้)
    function switchTab(tabId, btn = null) {
      const viewName = tabId.replace('tab-', '');
      switchRequesterView(viewName, btn);
    }

    let isFinishedHidden = false;

    // ซ่อนหรือแสดงรายการประวัติที่สิ้นสุดแล้ว (Soft Hide / No Delete)
    function toggleHideFinished() {
      isFinishedHidden = !isFinishedHidden;
      const btn = document.getElementById('btnToggleFinished');
      const icon = document.getElementById('toggleFinishedIcon');
      const text = document.getElementById('toggleFinishedText');
      const finishedCount = document.querySelectorAll('.my-booking-row[data-finished="true"]').length;

      // Re-apply current active category filter
      const activeChip = document.querySelector('.status-filter-chip.active');
      const currentCat = activeChip ? activeChip.getAttribute('onclick').match(/'([^']+)'/)[1] : 'ALL';
      filterMyBookings(currentCat, activeChip);

      if (btn && icon && text) {
        if (isFinishedHidden) {
          icon.innerText = '';
          text.innerText = `แสดงรายการที่สิ้นสุด (${finishedCount})`;
          btn.style.color = 'var(--primary)';
          btn.style.borderColor = 'var(--primary)';
        } else {
          icon.innerText = '';
          text.innerText = `ซ่อนรายการที่สิ้นสุดแล้ว (${finishedCount})`;
          btn.style.color = 'var(--slate)';
          btn.style.borderColor = 'var(--border)';
        }
      }
    }

    // กรองหมวดหมู่คำขอของฉันด้วย Modern Segmented Controls
    function filterMyBookings(category, btn) {
      document.querySelectorAll('.segmented-item, .status-filter-chip').forEach(c => c.classList.remove('active'));
      if (btn) btn.classList.add('active');

      let visibleCount = 0;
      const rows = document.querySelectorAll('.my-booking-row');
      rows.forEach(row => {
        const rowCat = row.getAttribute('data-category');
        const isFin = row.getAttribute('data-finished') === 'true';

        let show = false;
        if (category === 'PENDING') {
          show = (rowCat === 'PENDING');
        } else if (category === 'APPROVED') {
          show = (rowCat === 'APPROVED' || rowCat === 'IN_USE');
        } else if (category === 'FINISHED') {
          show = isFin; // เสร็จสิ้น, ยกเลิก, ปฏิเสธ
        } else if (category === 'ALL') {
          show = true;
        }

        row.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      const emptyRow = document.getElementById('myBookingsEmptyFilterRow');
      const emptyTitle = document.getElementById('myBookingsEmptyTitle');
      const emptyDesc = document.getElementById('myBookingsEmptyDesc');
      if (emptyRow) {
        emptyRow.style.display = visibleCount === 0 ? '' : 'none';
        if (emptyTitle && emptyDesc) {
          if (category === 'PENDING') {
            emptyTitle.innerText = 'ไม่มีรายการคำขอที่กำลังดำเนินการ';
            emptyDesc.innerText = 'ไม่มีคำขอที่อยู่ระหว่างรอการอนุมัติในขณะนี้';
          } else if (category === 'APPROVED') {
            emptyTitle.innerText = 'ไม่มีรายการที่ได้รับอนุมัติในขณะนี้';
            emptyDesc.innerText = 'รายการที่ได้รับการอนุมัติแล้วจะแสดงขึ้นที่นี่';
          } else if (category === 'FINISHED') {
            emptyTitle.innerText = 'ไม่มีรายการที่เสร็จสิ้น';
            emptyDesc.innerText = 'ไม่มีประวัติการใช้งานห้องที่เสร็จสิ้น ยกเลิก หรือปฏิเสธ';
          }
        }
      }
    }

    function selectBuilding(buildingNumber, btn) {
      document.querySelectorAll('.building-card, .building-pill, .building-box').forEach(b => b.classList.remove('active'));
      if (btn) {
        btn.classList.add('active');
      } else {
        const targetBtn = document.getElementById(`btn-building-${buildingNumber}`);
        if (targetBtn) targetBtn.classList.add('active');
      }

      // ซ่อนข้อความแนะนำก่อนเลือก และแสดงคอนเทนเนอร์ห้องประชุม & ตารางเวลา
      const notice = document.getElementById('noBuildingSelectedNotice');
      if (notice) notice.style.display = 'none';

      const container = document.getElementById('roomsContainer');
      if (container) container.style.display = 'block';

      const headerText = document.getElementById('activeBuildingHeaderText');
      if (headerText) {
        headerText.innerText = `ข้อมูลห้องประชุม - ตึก ${buildingNumber} (ห้อง ${buildingNumber}01 และ ห้อง ${buildingNumber}02)`;
      }

      // แสดงเฉพาะห้องของตึกที่เลือก (ตึกละ 2 ห้อง)
      document.querySelectorAll('.casual-room-card').forEach(card => {
        const cardBuilding = card.getAttribute('data-building');
        if (cardBuilding === String(buildingNumber)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });

      // เลื่อนสายตาลงมายังตารางห้องและช่วงเวลาว่าง
      if (container && btn) {
        container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // ฟังก์ชันช่วยหาเลขตึกจากข้อมูลห้อง
    function getBuildingFromRoom(room) {
      if (!room) return '1';
      if (room.location && room.location.includes('2')) return '2';
      if (room.location && room.location.includes('3')) return '3';
      if (room.room_name && (room.room_name.includes('201') || room.room_name.includes('202'))) return '2';
      if (room.room_name && (room.room_name.includes('301') || room.room_name.includes('302'))) return '3';
      return '1';
    }

    // Real-time Conflict Checker ตรวจสอบความถูกต้องทันทีก่อนส่ง
    function checkBookingConflict() {
      const roomSelect = document.getElementById('form_room_id');
      const dateInput = document.getElementById('form_booking_date');
      const startInput = document.getElementById('form_start_time');
      const endInput = document.getElementById('form_end_time');
      const banner = document.getElementById('conflictStatusBanner');
      const submitBtn = document.getElementById('submitBookingBtn');

      if (!roomSelect || !dateInput || !startInput || !endInput || !banner || !submitBtn) return;

      const roomId = Number(roomSelect.value);
      const dateStr = dateInput.value;
      const startTimeStr = startInput.value;
      const endTimeStr = endInput.value;

      if (!startTimeStr || !endTimeStr) return;

      const start = new Date(`${dateStr}T${startTimeStr}:00`);
      const end = new Date(`${dateStr}T${endTimeStr}:00`);

      // 1. ตรวจสอบเงื่อนไขเวลาเริ่มต้น - สิ้นสุด
      if (end <= start) {
        banner.className = 'conflict-status-banner is-conflict';
        banner.innerHTML = '<span>เวลาสิ้นสุดต้องมากกว่าเวลาเริ่มต้น</span>';
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
        return;
      }

      // 2. ตรวจสอบการทับซ้อนช่วงเวลากับรายการจองในระบบ Real-time
      const conflict = DAY_BOOKINGS.find(b => {
        if (Number(b.room_id) !== roomId) return false;
        if (!['PENDING_APPROVAL', 'APPROVED', 'IN_USE', 'BLOCKED'].includes(b.status)) return false;
        const bStart = new Date(b.start_time);
        const bEnd = new Date(b.end_time);
        return bStart < end && bEnd > start;
      });

      if (conflict) {
        banner.className = 'conflict-status-banner is-conflict';
        const statusLabel = conflict.status === 'BLOCKED' ? 'ปิดซ่อมบำรุง' : (conflict.status === 'PENDING_APPROVAL' ? 'มีคำขอรออนุมัติ' : 'มีผู้จองแล้ว');
        banner.innerHTML = `<span>ไม่สามารถเลือกได้: ชนกับ "${conflict.title}" (${statusLabel})</span>`;
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
      } else {
        const durationHours = Math.round((end - start) / (1000 * 60 * 60));
        banner.className = 'conflict-status-banner is-free';
        banner.innerHTML = `<span>ช่วงเวลานี้ว่าง สามารถทำรายการจองได้ (รวม ${durationHours} ชั่วโมง)</span>`;
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
      }
    }

    // เมื่อผู้ใช้เปลี่ยนเวลาเริ่มต้น (เลือกเฉพาะรายชั่วโมงเต็ม)
    function onStartTimeChange(runConflictCheck = true) {
      const startSelect = document.getElementById('form_start_time');
      const endSelect = document.getElementById('form_end_time');
      if (!startSelect || !endSelect) return;

      const startHour = parseInt(startSelect.value.split(':')[0], 10);
      const endHour = parseInt(endSelect.value.split(':')[0], 10);

      // Disable ตัวเลือกเวลาสิ้นสุดที่น้อยกว่าหรือเท่ากับเวลาเริ่มต้น
      Array.from(endSelect.options).forEach(opt => {
        const optHour = parseInt(opt.value.split(':')[0], 10);
        opt.disabled = optHour <= startHour;
      });

      // หากเวลาสิ้นสุดปัจจุบัน <= เวลาเริ่มต้น ให้ปรับเป็น startHour + 1
      if (endHour <= startHour) {
        const nextHour = Math.min(18, startHour + 1);
        endSelect.value = `${String(nextHour).padStart(2, '0')}:00`;
      }

      if (runConflictCheck) {
        checkBookingConflict();
      }
    }

    // ตรวจสอบจำนวนผู้เข้าร่วมไม่ให้เกินความจุของห้องที่เลือก
    function validateAttendees() {
      const attendeesInput = document.getElementById('form_attendees');
      const roomSelect = document.getElementById('form_room_id');
      const errorMsg = document.getElementById('attendeesErrorMsg');
      const submitBtn = document.getElementById('submitBookingBtn');
      if (!attendeesInput || !roomSelect) return true;

      const roomId = Number(roomSelect.value);
      const room = ROOMS.find(r => Number(r.room_id) === roomId);
      if (!room) return true;

      const maxCap = room.capacity;
      const count = parseInt(attendeesInput.value, 10);

      const maxDisplay = document.getElementById('attendeesMaxDisplay');
      const errorMax = document.getElementById('attendeesErrorMax');
      if (maxDisplay) maxDisplay.innerText = maxCap;
      if (errorMax) errorMax.innerText = maxCap;
      attendeesInput.max = maxCap;

      if (count > maxCap || isNaN(count) || count < 1) {
        if (errorMsg) {
          if (count > maxCap) {
            errorMsg.innerHTML = `จำนวนผู้เข้าร่วม (${count} คน) เกินความจุห้อง (ห้องนี้รับได้สูงสุด ${maxCap} คนเท่านั้น)`;
          } else {
            errorMsg.innerHTML = `กรุณาระบุจำนวนผู้เข้าร่วมอย่างน้อย 1 คน`;
          }
          errorMsg.style.display = 'block';
        }
        attendeesInput.style.borderColor = 'var(--danger)';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.5';
          submitBtn.style.cursor = 'not-allowed';
        }
        return false;
      } else {
        if (errorMsg) errorMsg.style.display = 'none';
        attendeesInput.style.borderColor = '';
        checkBookingConflict();
        return true;
      }
    }

    // เมื่อคลิกเลือกช่วงเวลาว่าง (Visual Slot Picker) -> แสดงฟอร์มให้กรอกทันที
    function selectRoomAndSlot(roomId, startStr, endStr) {
      const room = ROOMS.find(r => Number(r.room_id) === Number(roomId));
      const roomSelect = document.getElementById('form_room_id');
      const startInput = document.getElementById('form_start_time');
      const endInput = document.getElementById('form_end_time');
      const infoDiv = document.getElementById('modalSelectedRoomInfo');
      const lockedName = document.getElementById('locked_room_name');

      if (roomSelect) roomSelect.value = roomId;
      if (startInput) startInput.value = startStr;
      if (endInput) endInput.value = endStr;

      if (lockedName && room) {
        lockedName.innerHTML = `${room.room_name} <span style="font-weight: normal; color: var(--muted); font-size: 0.8rem;">(${room.location} &bull; จุ ${room.capacity} คน)</span>`;
      }

      if (infoDiv && room) {
        infoDiv.innerHTML = `<strong>${room.room_name}</strong> &bull; ${room.location} &bull; จุ ${room.capacity} คน`;
        selectBuilding(getBuildingFromRoom(room));
      }

      // ปรับความจุผู้เข้าร่วมสูงสุดตามขนาดห้องที่เลือก
      const attendeesInput = document.getElementById('form_attendees');
      const maxDisplay = document.getElementById('attendeesMaxDisplay');
      const errorMax = document.getElementById('attendeesErrorMax');
      if (room && attendeesInput) {
        attendeesInput.max = room.capacity;
        if (parseInt(attendeesInput.value, 10) > room.capacity) {
          attendeesInput.value = Math.min(5, room.capacity);
        }
      }
      if (room && maxDisplay) maxDisplay.innerText = room.capacity;
      if (room && errorMax) errorMax.innerText = room.capacity;
      validateAttendees();

      // ปรับตัวเลือกเวลาสิ้นสุดให้สอดคล้องกับเวลาเริ่มต้น
      onStartTimeChange(false);

      // ไฮไลต์การ์ดห้องที่เลือก
      document.querySelectorAll('.casual-room-card').forEach(c => c.classList.remove('selected-room'));
      const targetCard = document.getElementById(`room-card-${roomId}`);
      if (targetCard) targetCard.classList.add('selected-room');

      // ไฮไลต์ชิปเวลาที่เลือก
      document.querySelectorAll('.slot-interactive-chip').forEach(s => s.classList.remove('slot-selected'));
      const activeChip = document.querySelector(`.slot-interactive-chip[data-room="${roomId}"][data-start="${startStr}"]`);
      if (activeChip) activeChip.classList.add('slot-selected');

      // ตรวจสอบความว่าง Real-time ทันที
      checkBookingConflict();

      // สลับไปยังหน้าฟอร์มจองห้องทันที
      switchRequesterView('booking');
      const titleInput = document.getElementById('form_title');
      if (titleInput) {
        setTimeout(() => titleInput.focus(), 150);
      }
    }

    // ปิด Modal ฟอร์ม
    function closeBookingModal(e) {
      const modal = document.getElementById('bookingFormModal');
      if (modal) modal.style.display = 'none';
    }

    // เมื่อคลิกช่วงเวลาที่จองไม่ได้ (แสดง Toast ทันทีว่าเลือกไม่ได้)
    function showUnavailableNotice(roomName, startStr, endStr, bookingTitle, slotType) {
      const toast = document.getElementById('slotNoticeToast');
      const text = document.getElementById('slotNoticeText');
      if (!toast || !text) return;

      const typeTh = slotType === 'blocked' ? 'ปิดซ่อมบำรุง' : (slotType === 'pending' ? 'มีคำขอรออนุมัติ' : 'ติดคิวจองแล้ว');
      text.innerHTML = `<strong>เลือกไม่ได้:</strong> ${roomName} ช่วง ${startStr}-${endStr} น. ${typeTh} ("${bookingTitle}")`;
      toast.style.display = 'flex';

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, 3500);
    }

    // เมื่อผู้ใช้เปลี่ยนห้องจาก Dropdown ในฟอร์ม
    function onRoomSelectChange() {
      const roomId = document.getElementById('form_room_id').value;
      const room = ROOMS.find(r => Number(r.room_id) === Number(roomId));
      const infoDiv = document.getElementById('modalSelectedRoomInfo');
      if (infoDiv && room) {
        infoDiv.innerHTML = `<strong>${room.room_name}</strong> &bull; ${room.location} &bull; จุ ${room.capacity} คน`;
        selectBuilding(getBuildingFromRoom(room));
      }
      document.querySelectorAll('.casual-room-card').forEach(c => c.classList.remove('selected-room'));
      const targetCard = document.getElementById(`room-card-${roomId}`);
      if (targetCard) targetCard.classList.add('selected-room');
      checkBookingConflict();
    }

    // เมื่อผู้ใช้เปลี่ยนวันที่ในฟอร์ม
    function onDateInputChange() {
      const formDate = document.getElementById('form_booking_date').value;
      if (formDate && formDate !== '<%= selectedDate %>') {
        window.location.href = `/app?date=${formDate}`;
      } else {
        checkBookingConflict();
      }
    }

    // ดูไฟล์เอกสารแนบ (Anti-IDOR Stream)
    function openFilePreview(fileId, fileName) {
      const fileUrl = `/app/files/${fileId}`;
      document.getElementById('previewFileName').innerText = fileName;
      document.getElementById('previewDownloadBtn').href = fileUrl;
      document.getElementById('previewFrame').src = fileUrl;
      document.getElementById('filePreviewModal').style.display = 'flex';
    }

    function closePreviewModal(e) {
      document.getElementById('filePreviewModal').style.display = 'none';
      document.getElementById('previewFrame').src = 'about:blank';
    }

    // จัดการ Modal ปฏิเสธคำขอ (Approver Rejection)
    function openRejectModal(bookingId, title, requesterName) {
      const modal = document.getElementById('rejectModal');
      const form = document.getElementById('rejectForm');
      const sub = document.getElementById('rejectModalSubTitle');
      const commentInput = document.getElementById('reject_comment_input');

      if (form) form.action = `/app/bookings/${bookingId}/review`;
      if (sub) sub.innerHTML = `คำขอ: <strong>${title}</strong> &bull; โดย ${requesterName}`;
      if (commentInput) commentInput.value = 'ผู้บริหารมีความจำเป็นต้องใช้ห้องประชุมด่วนในช่วงเวลาดังกล่าว';
      if (modal) modal.style.display = 'flex';
    }

    function closeRejectModal(e) {
      if (e && e.target !== e.currentTarget && e.currentTarget.id !== 'rejectModal') return;
      const modal = document.getElementById('rejectModal');
      if (modal) modal.style.display = 'none';
    }

    // ================= Script สำหรับ Requester Mobile Flow (Adapted Layout) =================
    let rangeStartHour = 9;
    let rangeEndHour = 10;
    let isSettingEnd = false;

    const CAN_BOOK = <%= canBook ? 'true' : 'false' %>;
    const CAN_VIEW_OWN = <%= canViewOwnBookings ? 'true' : 'false' %>;

    // สลับ View ย่อยของ Requester (Home, Booking, My Bookings, Profile)
    function switchRequesterView(viewName, btnEl = null) {
      if (viewName === 'booking' && !CAN_BOOK) return;
      if (viewName === 'mybookings' && !CAN_VIEW_OWN) return;
      const targetView = document.getElementById('req-view-' + viewName);
      if (!targetView) return;

      document.querySelectorAll('.req-subview').forEach(v => v.style.display = 'none');
      targetView.style.display = 'block';

      // ซิงก์สถานะ Active ทั้งบน Desktop Sub-Nav และ Mobile Bottom Nav
      document.querySelectorAll('.bottom-nav-item, .desktop-nav-item').forEach(b => {
        if (b.getAttribute('data-view') === viewName) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (viewName === 'booking') {
        renderTimeRangePills();
        checkBookingConflict();
      }
    }

    // เริ่มต้นโฟลว์จองห้อง (จากปุ่ม Quick Booking หรือการ์ดห้องว่าง)
    function startBookingFlow(roomId = null, buildingNum = null) {
      if (!CAN_BOOK) return;
      switchRequesterView('booking');
      if (buildingNum) {
        selectBuilding(Number(buildingNum));
      } else {
        // ซ่อนกล่องห้องไว้ก่อนและล้างการเลือกตึกเดิมออก เพื่อให้ผู้ใช้กดเลือกตึกก่อน
        const roomsBox = document.getElementById('buildingRoomsBox');
        if (roomsBox) roomsBox.style.display = 'none';
        document.querySelectorAll('.building-card').forEach(b => b.classList.remove('active'));
      }
      if (roomId) {
        selectBookingRoom(roomId);
      }
    }

    // เมื่อเปลี่ยนห้องประชุมที่เลือก
    function onBookingRoomChange() {
      const select = document.getElementById('form_room_id');
      if (!select) return;
      const opt = select.options[select.selectedIndex];
      if (!opt) return;

      const bNum = opt.getAttribute('data-building');
      if (bNum) {
        document.querySelectorAll('.building-card').forEach(b => b.classList.remove('active'));
        const activeCard = document.getElementById(`btn-building-${bNum}`);
        if (activeCard) activeCard.classList.add('active');
      }

      const roomId = Number(select.value);
      const room = ROOMS.find(r => Number(r.room_id) === roomId);
      if (room) {
        const maxDisplay = document.getElementById('attendeesMaxDisplay');
        const attendeesInput = document.getElementById('form_attendees');
        if (maxDisplay) maxDisplay.innerText = room.capacity;
        if (attendeesInput) attendeesInput.max = room.capacity;
      }

      renderTimeRangePills();
      checkBookingConflict();
    }

    // ฟังก์ชันคลิกเลือกช่วงเวลาบน Time Range Grid (Screenshot 2)
    function onTimeRangePillClick(hour) {
      const pill = document.querySelector(`.time-slot-pill[data-hour="${hour}"]`);
      if (pill && pill.classList.contains('is-booked')) {
        const toast = document.getElementById('slotNoticeToast');
        const text = document.getElementById('slotNoticeText');
        if (toast && text) {
          text.innerHTML = `<strong>เลือกไม่ได้:</strong> ช่วงเวลา ${String(hour).padStart(2,'0')}:00 น. มีคิวจองหรือปิดปรับปรุง`;
          toast.style.display = 'flex';
          setTimeout(() => { toast.style.display = 'none'; }, 3000);
        }
        return;
      }

      const guidePill = document.getElementById('slotGuidePill');

      if (!isSettingEnd || hour <= rangeStartHour) {
        // กำหนดเวลาเริ่มต้น
        rangeStartHour = hour;
        rangeEndHour = Math.min(18, hour + 1);
        isSettingEnd = true;
        if (guidePill) {
          guidePill.className = 'conflict-status-banner is-free';
          guidePill.innerText = `เวลาเริ่ม: ${String(rangeStartHour).padStart(2,'0')}:00 น. -> กรุณาแตะเลือกเวลาสิ้นสุด`;
        }
      } else {
        // กำหนดเวลาสิ้นสุด
        rangeEndHour = hour;
        isSettingEnd = false;
        if (guidePill) {
          guidePill.className = 'conflict-status-banner is-free';
          guidePill.innerText = `ช่วงเวลาที่เลือก: ${String(rangeStartHour).padStart(2,'0')}:00 - ${String(rangeEndHour).padStart(2,'0')}:00 น. (${rangeEndHour - rangeStartHour} ชม.)`;
        }
      }

      const startSelect = document.getElementById('form_start_time');
      const endSelect = document.getElementById('form_end_time');
      if (startSelect) startSelect.value = `${String(rangeStartHour).padStart(2,'0')}:00`;
      if (endSelect) endSelect.value = `${String(rangeEndHour).padStart(2,'0')}:00`;

      renderTimeRangePills();
      checkBookingConflict();
    }

    // Render ไฮไลต์ช่วงเวลาบน Grid (Start, End, In-Range, Booked)
    function renderTimeRangePills() {
      const roomSelect = document.getElementById('form_room_id');
      if (!roomSelect) return;
      const roomId = Number(roomSelect.value);
      const room = ROOMS.find(r => Number(r.room_id) === roomId);

      document.querySelectorAll('.time-slot-pill').forEach(pill => {
        const h = parseInt(pill.getAttribute('data-hour'), 10);
        pill.className = 'time-slot-pill';

        if (h < 18) {
          const hStartStr = `${String(h).padStart(2,'0')}:00`;
          const hEndStr = `${String(h+1).padStart(2,'0')}:00`;
          const slotStart = new Date(`${'<%= selectedDate %>'}T${hStartStr}:00`);
          const slotEnd = new Date(`${'<%= selectedDate %>'}T${hEndStr}:00`);

          const overlap = DAY_BOOKINGS.find(b => {
            if (Number(b.room_id) !== roomId) return false;
            if (!['PENDING_APPROVAL', 'APPROVED', 'IN_USE', 'BLOCKED'].includes(b.status)) return false;
            const bStart = new Date(b.start_time);
            const bEnd = new Date(b.end_time);
            return bStart < slotEnd && bEnd > slotStart;
          });

          if (room && !room.is_active) {
            pill.classList.add('is-booked');
            pill.title = 'ห้องปิดปรับปรุง';
          } else if (overlap) {
            pill.classList.add('is-booked');
            pill.title = overlap.title || 'ติดคิว';
          }
        }

        if (h === rangeStartHour) {
          pill.classList.add('is-start');
        } else if (h === rangeEndHour) {
          pill.classList.add('is-end');
        } else if (h > rangeStartHour && h < rangeEndHour) {
          pill.classList.add('in-range');
        }
      });
    }

    // ฟังก์ชันเลือกห้องจากการ์ดห้องแบบ Visual
    function selectBookingRoom(roomId) {
      const hiddenInput = document.getElementById('form_room_id');
      if (hiddenInput) {
        hiddenInput.value = roomId;
      }

      // ไฮไลต์การ์ดที่ถูกเลือก
      document.querySelectorAll('.visual-room-card').forEach(c => {
        const match = c.getAttribute('data-room-id') === String(roomId);
        c.classList.toggle('selected', match);
        const radio = c.querySelector('.visual-room-radio');
        if (radio) radio.checked = match;
      });

      const room = ROOMS.find(r => Number(r.room_id) === Number(roomId));
      if (room) {
        const maxDisplay = document.getElementById('attendeesMaxDisplay');
        const attendeesInput = document.getElementById('form_attendees');
        if (maxDisplay) maxDisplay.innerText = room.capacity;
        if (attendeesInput) attendeesInput.max = room.capacity;
      }

      renderTimeRangePills();
      checkBookingConflict();
    }

    // ฟังก์ชันเลือกอาคารและกรอง Visual Room Cards
    const originalSelectBuilding = selectBuilding;
    selectBuilding = function(buildingNumber, btn = null) {
      document.querySelectorAll('.building-card').forEach(b => b.classList.remove('active'));
      if (btn) {
        btn.classList.add('active');
      } else {
        const targetBtn = document.getElementById(`btn-building-${buildingNumber}`);
        if (targetBtn) targetBtn.classList.add('active');
      }

      // แสดงกล่องเลือกห้องประชุมเมื่อคลิกเลือกตึก
      const roomsBox = document.getElementById('buildingRoomsBox');
      const headerLabel = document.getElementById('buildingRoomsHeaderLabel');
      if (roomsBox) {
        roomsBox.style.display = 'block';
      }
      if (headerLabel) {
        headerLabel.innerText = `ห้องประชุมในตึก ${buildingNumber}:`;
      }

      let visibleCount = 0;
      let firstMatchRoomId = null;
      document.querySelectorAll('.visual-room-card').forEach(c => {
        const b = c.getAttribute('data-building');
        const isMatch = b === String(buildingNumber);
        c.style.display = isMatch ? 'flex' : 'none';
        if (isMatch) {
          visibleCount++;
          if (!firstMatchRoomId) {
            firstMatchRoomId = c.getAttribute('data-room-id');
          }
        }
      });

      const roomsGrid = document.getElementById('visualRoomsGrid');
      if (roomsGrid) {
        roomsGrid.setAttribute('data-count', String(visibleCount));
      }

      const hiddenInput = document.getElementById('form_room_id');
      const currentSelected = hiddenInput ? hiddenInput.value : null;
      const currentCard = currentSelected ? document.querySelector(`.visual-room-card[data-room-id="${currentSelected}"]`) : null;
      const isCurrentInBuilding = currentCard && currentCard.getAttribute('data-building') === String(buildingNumber);

      if (!isCurrentInBuilding && firstMatchRoomId) {
        selectBookingRoom(firstMatchRoomId);
      } else if (currentSelected) {
        selectBookingRoom(currentSelected);
      }

      renderTimeRangePills();
      checkBookingConflict();

      if (roomsBox && btn) {
        roomsBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };

    // ตรวจสอบความว่างเริ่มต้นเมื่อโหลดหน้า
    document.addEventListener('DOMContentLoaded', () => {
      // Auto-dismiss Flash Success Alert after 3.5s
      const flashAlert = document.getElementById('flashSuccessAlert');
      if (flashAlert) {
        setTimeout(() => {
          flashAlert.style.transition = 'opacity 0.4s ease';
          flashAlert.style.opacity = '0';
          setTimeout(() => flashAlert.remove(), 400);
        }, 3500);
      }

      // Smart Default Filter สำหรับ My Bookings: เปิดแท็บที่มีรายการค้างอยู่
      const pendingBtn = document.querySelector('.segmented-item[data-category="PENDING"]');
      const approvedBtn = document.querySelector('.segmented-item[data-category="APPROVED"]');
      const finishedBtn = document.querySelector('.segmented-item[data-category="FINISHED"]');
      
      const pendingBadge = pendingBtn ? parseInt(pendingBtn.querySelector('.segmented-badge')?.innerText || '0', 10) : 0;
      const approvedBadge = approvedBtn ? parseInt(approvedBtn.querySelector('.segmented-badge')?.innerText || '0', 10) : 0;
      const finishedBadge = finishedBtn ? parseInt(finishedBtn.querySelector('.segmented-badge')?.innerText || '0', 10) : 0;

      if (pendingBadge > 0 && pendingBtn) {
        filterMyBookings('PENDING', pendingBtn);
      } else if (approvedBadge > 0 && approvedBtn) {
        filterMyBookings('APPROVED', approvedBtn);
      } else if (finishedBadge > 0 && finishedBtn) {
        filterMyBookings('FINISHED', finishedBtn);
      } else if (pendingBtn) {
        filterMyBookings('PENDING', pendingBtn);
      }

      checkBookingConflict();
      renderTimeRangePills();
      
      // ดักจับคลิกปุ่มปฏิเสธ
      document.querySelectorAll('.btn-open-reject').forEach(btn => {
        btn.addEventListener('click', function() {
          openRejectModal(this.dataset.bookingId, this.dataset.title, this.dataset.requester);
        });
      });

      const urlParams = new URLSearchParams(window.location.search);
      const bParam = urlParams.get('building');
      if (bParam && ['1', '2', '3'].includes(bParam)) {
        selectBuilding(Number(bParam));
      }

      // ตรวจสอบ query string เพื่อเปิด subview ที่ระบุทันที
      const viewParam = urlParams.get('view') || urlParams.get('tab');
      if (viewParam) {
        const cleanView = viewParam.replace('tab-', '');
        const validViews = ['home', 'booking', 'mybookings', 'profile', 'approvals', 'facility', 'facility-block', 'timeline'];
        if (validViews.includes(cleanView)) {
          switchRequesterView(cleanView);
        }
      }

      // Auto-scroll ปฏิทินจิ๋วให้การ์ดวันที่เลือกอยู่ตรงกลางสายตา
      const activeCalCard = document.querySelector('.mini-cal-day-card.active');
      if (activeCalCard) {
        activeCalCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });

    // เปลี่ยนวันที่ใช้งานสำหรับปฏิทินจิ๋ว (คงค่าอาคารและสถานะวิวไว้)
    function changeBookingDate(newDate) {
      if (!newDate) return;
      const url = new URL(window.location.href);
      url.searchParams.set('date', newDate);
      url.searchParams.set('view', 'booking');
      
      // รักษาอาคารที่เลือกไว้
      const activeBuilding = document.querySelector('.building-card.active');
      if (activeBuilding) {
        const bNum = activeBuilding.id.replace('btn-building-', '');
        if (bNum) url.searchParams.set('building', bNum);
      }
      window.location.href = url.toString();
    }

    // เลื่อนวันในปฏิทินจิ๋ว (+1 หรือ -1 วัน)
    function navigateMiniCal(direction) {
      const cur = new Date('<%= selectedDate %>' + 'T00:00:00');
      cur.setDate(cur.getDate() + direction);
      const minDate = new Date('<%= todayStr %>' + 'T00:00:00');
      if (cur < minDate) return; // ไม่ให้ย้อนหลังเกินวันนี้
      
      const yyyy = cur.getFullYear();
      const mm = String(cur.getMonth() + 1).padStart(2, '0');
      const dd = String(cur.getDate()).padStart(2, '0');
      changeBookingDate(`${yyyy}-${mm}-${dd}`);
    }
  </script>

  <!-- Mobile Bottom Navigation Bar (Dynamic per Permission & Role) -->
  <nav class="mobile-bottom-nav">
    <button type="button" class="bottom-nav-item active" data-view="home" onclick="switchRequesterView('home', this)">
      <span>หน้าแรก</span>
    </button>

    <% if (canApprove) { %>
      <button type="button" class="bottom-nav-item" data-view="approvals" onclick="switchRequesterView('approvals', this)">
        <span>รออนุมัติ</span>
        <% if (pendingApprovals.length > 0) { %>
          <span class="nav-badge" style="background: #f59e0b;"><%= pendingApprovals.length %></span>
        <% } %>
      </button>
    <% } %>

    <% if (canFacility) { %>
      <button type="button" class="bottom-nav-item" data-view="facility" onclick="switchRequesterView('facility', this)">
        <span>ส่งมอบ</span>
        <% if (facilityTasks.length > 0) { %>
          <span class="nav-badge" style="background: #10b981;"><%= facilityTasks.length %></span>
        <% } %>
      </button>
    <% } %>

    <% if (canBlockSchedule) { %>
      <button type="button" class="bottom-nav-item" data-view="facility-block" onclick="switchRequesterView('facility-block', this)">
        <span>ปิดซ่อม</span>
      </button>
    <% } %>

    <% if (isAdminUser) { %>
      <button type="button" class="bottom-nav-item" data-view="timeline" onclick="switchRequesterView('timeline', this)">
        <span>ไทม์ไลน์</span>
      </button>
    <% } %>

    <% if (canBook) { %>
      <button type="button" class="bottom-nav-item" data-view="booking" onclick="switchRequesterView('booking', this)">
        <span>จองห้อง</span>
      </button>
    <% } %>

    <% if (canViewOwnBookings) { %>
      <button type="button" class="bottom-nav-item" data-view="mybookings" onclick="switchRequesterView('mybookings', this)">
        <span>การจองของฉัน</span>
        <% if (activeMyBookingsCount > 0) { %>
          <span class="nav-badge"><%= activeMyBookingsCount %></span>
        <% } %>
      </button>
    <% } %>

    <button type="button" class="bottom-nav-item" data-view="profile" onclick="switchRequesterView('profile', this)">
      <span>โปรไฟล์</span>
    </button>
  </nav>

</body>
</html>
