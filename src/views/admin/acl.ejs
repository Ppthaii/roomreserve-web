<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %></title>

  <!-- PWA & Mobile Standalone App Support (เปิดแอปเต็มจอ ไม่มีแถบ URL) -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1d4ed8">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="RoomReserve">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png">

  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
  <script src="/session-guard.js"></script>
  <style>
    /* Toast Notification สำหรับแจ้งเตือนการ Auto-Save ทันที */
    #toast-container {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 1000;
    }
    .toast {
      background: #1e1b4b;
      color: white;
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      margin-top: 0.5rem;
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.2);
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      animation: slideIn 0.3s ease-out;
      border-left: 4px solid #10b981;
    }
    .toast-error {
      border-left-color: #ef4444;
    }
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    .switch-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #10b981;
      margin-right: 6px;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { opacity: 0.6; }
      50% { opacity: 1; transform: scale(1.1); }
      100% { opacity: 0.6; }
    }
  </style>
</head>
<body>
  <!-- Toast Container -->
  <div id="toast-container"></div>

  <!-- Navbar หลัก -->
  <nav class="navbar">
    <a href="/app" class="nav-brand">RoomReserve</a>
    <div class="nav-links">
      <a href="/app">ตารางปฏิทิน & คิวงาน</a>
      <a href="/admin/acl" class="active" style="color: #4f46e5; font-weight: 700;">ตารางสิทธิ์ (Dynamic ACL)</a>
      <a href="/admin/logs">Audit Logs</a>
      <a href="/admin/users">ผู้ใช้งาน</a>
      <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" title="สลับโหมดมืด/สว่าง">โหมดมืด</button>
      <div class="user-badge">
        <span><%= user.username %></span>
        <span class="role-pill"><%= user.roleName %></span>
      </div>
      <form action="/logout" method="POST" style="margin: 0;">
        <button type="submit" class="btn btn-outline btn-sm">ออกจากระบบ</button>
      </form>
    </div>
  </nav>

  <div class="container">
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 800; display: flex; align-items: center;">
            <span class="switch-indicator"></span> ตารางกำหนดสิทธิ์ Real-time (Dynamic ACL Matrix)
          </h2>
          <p style="color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem;">
            <strong>Instant Apply:</strong> ติ๊กเลือกหรือยกเลิกสิทธิ์แล้วระบบ <strong>บันทึกทันทีในระดับ Database</strong> โดยไม่ต้องกดปุ่มยืนยันและไม่ต้อง Restart Server!
          </p>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-outline btn-sm" onclick="toggleModal('modal-add-role')">
            เพิ่ม Role ใหม่ (Live Demo 5)
          </button>
          <button type="button" class="btn btn-outline btn-sm" onclick="toggleModal('modal-add-perm')">
            เพิ่ม Permission ใหม่ (Live Demo 6)
          </button>
          <div style="background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.8rem; color: #065f46; font-weight: 600; display: flex; align-items: center;">
            Instant Auto-Save
          </div>
        </div>
      </div>

      <!-- Modal เพิ่ม Role ใหม่ -->
      <div id="modal-add-role" style="display: none; background: #f8fafc; border: 1px solid var(--border); padding: 1.25rem; border-radius: 12px; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.75rem;">เพิ่มบทบาทใหม่ (Role Creation)</h3>
        <form action="/admin/roles/create" method="POST" style="display: grid; grid-template-columns: 1fr 1fr 2fr auto; gap: 0.75rem; align-items: end;">
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">รหัสบทบาท (Code เช่น auditor, guest)</label>
            <input type="text" name="role_name" class="form-control" placeholder="auditor" required>
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">ชื่อแสดง (Display Name)</label>
            <input type="text" name="display_name" class="form-control" placeholder="ผู้ตรวจประเมิน (Auditor)" required>
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">คำอธิบาย</label>
            <input type="text" name="description" class="form-control" placeholder="ทำหน้าที่ตรวจสอบและสอบทานรายงาน">
          </div>
          <div style="display: flex; gap: 0.4rem;">
            <button type="submit" class="btn btn-primary btn-sm">สร้าง Role ทันที</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="toggleModal('modal-add-role')">ยกเลิก</button>
          </div>
        </form>
      </div>

      <!-- Modal เพิ่ม Permission ใหม่ -->
      <div id="modal-add-perm" style="display: none; background: #f8fafc; border: 1px solid var(--border); padding: 1.25rem; border-radius: 12px; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.75rem;">เพิ่มสิทธิ์ใหม่ (Permission Creation)</h3>
        <form action="/admin/permissions/create" method="POST" style="display: grid; grid-template-columns: 1.5fr 2fr 1fr auto; gap: 0.75rem; align-items: end;">
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">รหัสสิทธิ์ (Namespace code เช่น room.export_pdf)</label>
            <input type="text" name="permission_code" class="form-control" placeholder="room.export_pdf" required>
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">คำอธิบายสิทธิ์</label>
            <input type="text" name="description" class="form-control" placeholder="ส่งออกรายงานการใช้ห้องเป็น PDF" required>
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">หมวดหมู่</label>
            <select name="category" class="form-control">
              <option value="room">ห้องประชุม (room)</option>
              <option value="booking">การจอง (booking)</option>
              <option value="facility">สถานที่ (facility)</option>
              <option value="file">เอกสาร (file)</option>
              <option value="admin">ผู้ดูแลระบบ (admin)</option>
            </select>
          </div>
          <div style="display: flex; gap: 0.4rem;">
            <button type="submit" class="btn btn-primary btn-sm">สร้าง สิทธิ์ ทันที</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="toggleModal('modal-add-perm')">ยกเลิก</button>
          </div>
        </form>
      </div>

      <!-- Modal แก้ไข Role -->
      <div id="modal-edit-role" style="display: none; background: #eff6ff; border: 1px solid #bfdbfe; padding: 1.25rem; border-radius: 12px; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.75rem; color: #1e40af;">แก้ไขข้อมูลบทบาท (Role Update)</h3>
        <form id="form-edit-role" method="POST" style="display: grid; grid-template-columns: 1fr 2fr auto; gap: 0.75rem; align-items: end;">
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">ชื่อแสดง (Display Name)</label>
            <input type="text" id="edit-role-display" name="display_name" class="form-control" required>
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">คำอธิบาย</label>
            <input type="text" id="edit-role-desc" name="description" class="form-control">
          </div>
          <div style="display: flex; gap: 0.4rem;">
            <button type="submit" class="btn btn-primary btn-sm">บันทึก</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="toggleModal('modal-edit-role')">ยกเลิก</button>
          </div>
        </form>
      </div>

      <!-- Modal แก้ไข Permission -->
      <div id="modal-edit-perm" style="display: none; background: #eff6ff; border: 1px solid #bfdbfe; padding: 1.25rem; border-radius: 12px; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.75rem; color: #1e40af;">แก้ไขข้อมูลสิทธิ์ (<span id="edit-perm-code-label"></span>)</h3>
        <form id="form-edit-perm" method="POST" style="display: grid; grid-template-columns: 2fr 1fr auto; gap: 0.75rem; align-items: end;">
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">คำอธิบายสิทธิ์</label>
            <input type="text" id="edit-perm-desc" name="description" class="form-control" required>
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem;">หมวดหมู่</label>
            <select id="edit-perm-cat" name="category" class="form-control">
              <option value="room">ห้องประชุม (room)</option>
              <option value="booking">การจอง (booking)</option>
              <option value="facility">สถานที่ (facility)</option>
              <option value="file">เอกสาร (file)</option>
              <option value="admin">ผู้ดูแลระบบ (admin)</option>
              <option value="general">ทั่วไป (general)</option>
            </select>
          </div>
          <div style="display: flex; gap: 0.4rem;">
            <button type="submit" class="btn btn-primary btn-sm">บันทึก</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="toggleModal('modal-edit-perm')">ยกเลิก</button>
          </div>
        </form>
      </div>

      <div class="table-responsive">
        <table class="table" style="text-align: center;">
          <thead>
            <tr>
              <th style="text-align: left;">รหัสสิทธิ์ (Permission Code)</th>
              <th style="text-align: left;">คำอธิบายสิทธิ์</th>
              <% roles.forEach(r => { %>
                <th style="text-align: center; vertical-align: top;">
                  <div><%= r.display_name %></div>
                  <div style="font-size: 0.72rem; color: var(--muted); font-weight: normal; margin-top: 2px;">
                    (<%= r.role_name %>)
                  </div>
                  <div style="display: flex; gap: 4px; justify-content: center; margin-top: 6px;">
                    <button type="button" class="btn btn-outline btn-xs btn-edit-role" 
                            style="padding: 2px 6px; font-size: 0.7rem;" 
                            data-role-id="<%= r.role_id %>"
                            data-display-name="<%= r.display_name %>"
                            data-description="<%= r.description || '' %>"
                            title="แก้ไขชื่อ">✏️</button>
                    <% if (r.role_name !== 'admin') { %>
                      <form action="/admin/roles/<%= r.role_id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('ยืนยันลบบทบาท <%= r.display_name %> ? (จะลบได้เมื่อไม่มีผู้ใช้ผูกอยู่เท่านั้น)')">
                        <button type="submit" class="btn btn-outline btn-xs" style="padding: 2px 6px; font-size: 0.7rem; color: #ef4444; border-color: #fca5a5;" title="ลบบทบาท">🗑️</button>
                      </form>
                    <% } %>
                  </div>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% permissions.forEach(p => { %>
              <% const isCore = ['room.view_schedule', 'room.manage', 'room.block_schedule', 'booking.create', 'booking.read_own', 'booking.read_all', 'booking.cancel_own', 'booking.approve', 'facility.checkin', 'facility.checkout', 'file.upload_agenda', 'file.upload_inspect', 'file.view', 'acl.manage', 'user.manage', 'log.read'].includes(p.permission_code); %>
              <tr>
                <td style="text-align: left;">
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                    <code><%= p.permission_code %></code>
                    <div style="display: flex; gap: 4px;">
                      <button type="button" class="btn btn-outline btn-xs btn-edit-perm" 
                              style="padding: 2px 5px; font-size: 0.7rem;" 
                              data-perm-id="<%= p.permission_id %>"
                              data-perm-code="<%= p.permission_code %>"
                              data-description="<%= p.description %>"
                              data-category="<%= p.category || 'general' %>"
                              title="แก้ไขคำอธิบาย">✏️</button>
                      <% if (!isCore) { %>
                        <form action="/admin/permissions/<%= p.permission_id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('ยืนยันลบรหัสสิทธิ์ <%= p.permission_code %> ?')">
                          <button type="submit" class="btn btn-outline btn-xs" style="padding: 2px 5px; font-size: 0.7rem; color: #ef4444; border-color: #fca5a5;" title="ลบสิทธิ์">🗑️</button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td style="text-align: left; font-size: 0.85rem; color: var(--slate);">
                  <%= p.description %>
                </td>
                <% roles.forEach(r => { %>
                  <% const isChecked = grantSet.has(`${r.role_id}_${p.permission_id}`); %>
                  <% const isDisabled = (r.role_name === 'admin' && p.permission_code === 'acl.manage'); %>
                  <td>
                    <input 
                      type="checkbox" 
                      class="acl-checkbox"
                      data-role-id="<%= r.role_id %>"
                      data-permission-id="<%= p.permission_id %>"
                      data-perm-code="<%= p.permission_code %>"
                      data-role-name="<%= r.display_name %>"
                      <%= isChecked ? 'checked' : '' %>
                      <%= isDisabled ? 'checked disabled title="ต้องคงสิทธิ์ Admin ไว้เสมอเพื่อป้องกันระบบล็อกตัวเอง"' : '' %>
                      style="width: 20px; height: 20px; accent-color: var(--primary); cursor: pointer;"
                    >
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- กล่องแนะนำวิธีสาธิตให้อาจารย์ดูสด -->
    <div class="card" style="background: #fdf4ff; border-color: #f5d0fe;">
      <div class="card-title" style="color: #86198f;">วิธีสาธิตให้อาจารย์ดูสดใน 10 วินาที (Instant Real-time Demo)</div>
      <ol style="font-size: 0.85rem; color: #581c87; padding-left: 1.25rem; line-height: 1.6;">
        <li>เปิดหน้าเว็บนี้ไว้ แล้วเปิดอีกแท็บหนึ่งล็อกอินเป็น <strong>somchai (Requester)</strong></li>
        <li>ที่แท็บนี้ ให้ <strong>คลิกติ๊กเอาเครื่องหมายถูกออก</strong> ตรงช่อง <code>booking.create</code> ของ Requester (ระบบจะเซฟและขึ้นแจ้งเตือนทันทีโดยไม่ต้องกดปุ่ม Save)</li>
        <li>สลับไปที่แท็บของ <strong>somchai</strong> แล้วลองกดยื่นจองห้อง จะถูกดีด <strong>403 Forbidden ทันทีในเสี้ยววินาที</strong>!</li>
        <li>เมื่อต้องการคืนสิทธิ์ แค่คลิกติ๊กเครื่องหมายถูกกลับมาที่เดิม สิทธิ์จะกลับมาใช้งานได้ทันที</li>
      </ol>
    </div>
  </div>

  <script>
    // ดักจับ Event เมื่อมีการคลิก Checkbox ทุกตัวในตาราง
    document.querySelectorAll('.acl-checkbox').forEach(box => {
      box.addEventListener('change', async function() {
        const roleId = this.getAttribute('data-role-id');
        const permissionId = this.getAttribute('data-permission-id');
        const permCode = this.getAttribute('data-perm-code');
        const roleName = this.getAttribute('data-role-name');
        const granted = this.checked;

        // Effect ขณะกำลังบันทึก
        this.style.opacity = '0.5';

        try {
          const res = await fetch('/admin/acl/toggle', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              role_id: roleId,
              permission_id: permissionId,
              granted: granted
            })
          });

          const data = await res.json();
          this.style.opacity = '1';

          if (res.ok) {
            const actionText = granted ? 'เปิดสิทธิ์' : 'เพิกถอนสิทธิ์';
            showToast(`${actionText} "${permCode}" ให้ ${roleName} สำเร็จทันที!`);
          } else {
            // หาก Server ปฏิเสธ (เช่น ล็อกสิทธิ์ Admin) ให้คืนค่าเดิม
            this.checked = !granted;
            showToast(`${data.error || 'เกิดข้อผิดพลาด'}`, true);
          }
        } catch (err) {
          this.style.opacity = '1';
          this.checked = !granted;
          showToast(`ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้`, true);
        }
      });
    });

    // ดักจับ Event สำหรับปุ่มแก้ไข Role และ Permission
    document.querySelectorAll('.btn-edit-role').forEach(btn => {
      btn.addEventListener('click', function() {
        openEditRole(this.dataset.roleId, this.dataset.displayName, this.dataset.description || '');
      });
    });

    document.querySelectorAll('.btn-edit-perm').forEach(btn => {
      btn.addEventListener('click', function() {
        openEditPerm(this.dataset.permId, this.dataset.permCode, this.dataset.description, this.dataset.category || 'general');
      });
    });

    function toggleModal(id) {
      const el = document.getElementById(id);
      el.style.display = (el.style.display === 'none' || el.style.display === '') ? 'block' : 'none';
    }

    function openEditRole(roleId, displayName, description) {
      document.getElementById('form-edit-role').action = `/admin/roles/${roleId}/update`;
      document.getElementById('edit-role-display').value = displayName;
      document.getElementById('edit-role-desc').value = description;
      document.getElementById('modal-edit-role').style.display = 'block';
      document.getElementById('modal-edit-role').scrollIntoView({ behavior: 'smooth' });
    }

    function openEditPerm(permId, permCode, description, category) {
      document.getElementById('form-edit-perm').action = `/admin/permissions/${permId}/update`;
      document.getElementById('edit-perm-code-label').innerText = permCode;
      document.getElementById('edit-perm-desc').value = description;
      document.getElementById('edit-perm-cat').value = category || 'general';
      document.getElementById('modal-edit-perm').style.display = 'block';
      document.getElementById('modal-edit-perm').scrollIntoView({ behavior: 'smooth' });
    }

    function showToast(msg, isError = false) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `toast ${isError ? 'toast-error' : ''}`;
      toast.innerHTML = `<span>${msg}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.5s';
        setTimeout(() => toast.remove(), 500);
      }, 3500);
    }
  </script>
</body>
</html>
