<!DOCTYPE html>
<html lang="th">
<head>
  <%- include('../partials/head') %>
  <script src="/session-guard.js"></script>
</head>
<body>
  <%- include('../partials/navbar', { active: 'users' }) %>

  <div class="container">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="card">
      <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">จัดการบัญชีผู้ใช้งาน (User Management)</h2>
      <p style="color: var(--muted); font-size: 0.85rem; margin-bottom: 1.5rem;">
        ระบบแสดงรายชื่อผู้ใช้ทั้ง 4 Roles และสามารถสลับสถานะเปิดใช้งาน/ระงับการใช้งานได้ทันที
      </p>

      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>ชื่อ-นามสกุล</th>
              <th>แผนก / สังกัด</th>
              <th>บทบาท (Role)</th>
              <th>สถานะบัญชี</th>
              <th>จัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.user_id %></td>
                <td><strong><%= u.username %></strong></td>
                <td><%= u.full_name %></td>
                <td><%= u.department || '-' %></td>
                <td>
                  <form action="/admin/users/<%= u.user_id %>/role" method="POST" style="display:inline-flex; align-items:center; gap:0.35rem;">
                    <select name="role_id" class="form-control" style="padding:0.25rem 0.5rem; font-size:0.8rem; width:auto;" onchange="this.form.submit()">
                      <% roles.forEach(r => { %>
                        <option value="<%= r.role_id %>" <%= r.role_id === u.role_id ? 'selected' : '' %>>
                          <%= r.display_name %>
                        </option>
                      <% }) %>
                    </select>
                  </form>
                </td>
                <td>
                  <% if (u.is_active) { %>
                    <span class="status-badge status-COMPLETED">เปิดใช้งาน (Active)</span>
                  <% } else { %>
                    <span class="status-badge status-REJECTED">ระงับชั่วคราว (Suspended)</span>
                  <% } %>
                </td>
                <td>
                  <% if (u.user_id === user.id) { %>
                    <span style="color: var(--muted); font-size: 0.8rem;">(บัญชีปัจจุบัน)</span>
                  <% } else { %>
                    <form action="/admin/users/<%= u.user_id %>/toggle" method="POST" style="display:inline;">
                      <button class="btn <%= u.is_active ? 'btn-danger' : 'btn-success' %> btn-sm">
                        <%= u.is_active ? 'ระงับการใช้งาน' : 'เปิดใช้งาน' %>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
