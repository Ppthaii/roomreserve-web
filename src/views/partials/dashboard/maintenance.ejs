<div id="req-view-facility-block" class="req-subview" style="display: none;">
  <!-- Header / Stepper Banner -->
  <div class="card" style="margin-bottom: 1rem; border-left: 4px solid var(--warning);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin: 0 0 0.35rem 0; display: flex; align-items: center; gap: 0.4rem;">
          <span>🛠️</span> บล็อกปิดห้องซ่อมบำรุง & งานพิเศษ
        </h3>
        <p style="font-size: 0.82rem; color: var(--muted); margin: 0;">
          ระงับการจองห้องชั่วคราวสำหรับงานช่าง ซ่อมบำรุงระบบ หรือจัดกิจกรรมเฉพาะกิจส่วนกลาง
        </p>
      </div>
      <span class="status-badge" style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-weight: 700; font-size: 0.75rem; padding: 0.25rem 0.65rem;">
        Facility Management
      </span>
    </div>
  </div>

  <form action="/app/facility/block" method="POST" id="maintBlockForm">
    <!-- Hidden inputs สำหรับเก็บค่าห้องและวันที่ -->
    <input type="hidden" name="room_id" id="maint_form_room_id" value="<%= rooms[0] ? rooms[0].room_id : '' %>" required>
    <input type="hidden" name="block_date" id="maint_block_date_input" value="<%= selectedDate %>" required>

    <!-- ================= STEP 1: เลือกอาคาร & ห้องประชุม ================= -->
    <div class="card" style="margin-bottom: 1.25rem; border-left: 4px solid #f59e0b;">
      <div style="font-size: 0.95rem; font-weight: 800; color: var(--dark); margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <span style="background: #f59e0b; color: white; border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">1</span>
          <span>เลือกอาคารและห้องประชุมที่จะปิดซ่อม:</span>
        </div>
        <span style="font-weight: 500; font-size: 0.78rem; color: var(--muted);">(คลิกอาคารเพื่อดูห้อง)</span>
      </div>

      <!-- ปุ่มเลือกอาคาร 1, 2, 3 -->
      <div class="building-cards-grid" style="margin-bottom: 1rem;">
        <div class="building-card" onclick="selectMaintBuilding(1, this)" id="btn-maint-building-1">
          <div class="building-card-img-wrap">
            <img src="/images/building1.jpg" alt="ตึก 1" class="building-card-img" onerror="this.src='/images/building1.jpg'">
          </div>
          <div class="building-card-body">
            <div class="building-card-title">ตึก 1</div>
            <div class="building-card-rooms"><%= b1Names || 'ไม่มีห้องประชุม' %></div>
          </div>
        </div>

        <div class="building-card" onclick="selectMaintBuilding(2, this)" id="btn-maint-building-2">
          <div class="building-card-img-wrap">
            <img src="/images/building2.jpg" alt="ตึก 2" class="building-card-img" onerror="this.src='/images/building2.jpg'">
          </div>
          <div class="building-card-body">
            <div class="building-card-title">ตึก 2</div>
            <div class="building-card-rooms"><%= b2Names || 'ไม่มีห้องประชุม' %></div>
          </div>
        </div>

        <div class="building-card" onclick="selectMaintBuilding(3, this)" id="btn-maint-building-3">
          <div class="building-card-img-wrap">
            <img src="/images/building3.jpg" alt="ตึก 3" class="building-card-img" onerror="this.src='/images/building3.jpg'">
          </div>
          <div class="building-card-body">
            <div class="building-card-title">ตึก 3</div>
            <div class="building-card-rooms"><%= b3Names || 'ไม่มีห้องประชุม' %></div>
          </div>
        </div>
      </div>

      <!-- รายการการ์ดห้องประชุมในตึกที่เลือก -->
      <div id="maintBuildingRoomsBox" style="display: none; padding-top: 0.75rem; border-top: 1px dashed var(--border);">
        <div style="font-size: 0.88rem; font-weight: 700; color: var(--dark); margin-bottom: 0.65rem; display: flex; align-items: center; justify-content: space-between;">
          <span id="maintBuildingRoomsHeaderLabel">ห้องประชุมในอาคาร:</span>
          <span id="maintSelectedRoomNoticeBadge" style="font-size: 0.72rem; font-weight: 700; color: #b45309; background: #fef3c7; padding: 0.2rem 0.6rem; border-radius: 9999px;">
            เลือกแล้ว
          </span>
        </div>
        <div class="visual-rooms-grid" id="maintVisualRoomsGrid">
          <% rooms.forEach(room => { 
            let bNum = getBuildingNumHelper(room);
            const bImg = `/images/building${['1','2','3'].includes(bNum) ? bNum : '1'}.jpg`;
          %>
            <div class="visual-room-card maint-visual-card <%= !room.is_active ? 'is-suspended' : '' %>" data-building="<%= bNum %>" data-room-id="<%= room.room_id %>" data-capacity="<%= room.capacity %>" onclick="selectMaintRoom('<%= room.room_id %>')">
              <div class="visual-room-img-wrap" style="position: relative;">
                <img src="<%= bImg %>" alt="<%= room.room_name %>" class="visual-room-img" onerror="this.src='/images/building1.jpg'">
                <% if (!room.is_active) { %>
                  <div class="room-suspended-overlay">ระงับการใช้งาน</div>
                <% } %>
              </div>
              <div class="visual-room-body">
                <div class="visual-room-name">
                  <%= room.room_name %>
                  <% if (!room.is_active) { %>
                    <span style="font-size: 0.72rem; color: #dc2626; font-weight: 700;">[ระงับการใช้งาน]</span>
                  <% } %>
                </div>
                <div class="visual-room-meta">
                  <span class="visual-room-badge"><%= room.location %></span>
                  <span class="visual-room-badge">รองรับ <%= room.capacity %> คน</span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ================= STEP 2: วันที่และช่วงเวลาปิดซ่อม ================= -->
    <div class="card" style="margin-bottom: 1.25rem; border-left: 4px solid #f59e0b;">
      <div style="font-size: 0.95rem; font-weight: 800; color: var(--dark); margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <span style="background: #f59e0b; color: white; border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">2</span>
          <span>กำหนดวันและช่วงเวลาที่ต้องการบล็อกปิดซ่อม:</span>
        </div>
        <button type="button" class="btn btn-outline btn-sm" onclick="blockWholeDayMaint()" style="font-size: 0.78rem; font-weight: 700; border-color: #f59e0b; color: #b45309;">
          ⚡ บล็อกทั้งวัน (09:00 - 18:00 น.)
        </button>
      </div>

      <!-- ปฏิทินจิ๋ว Mini Calendar Strip -->
      <div class="mini-calendar-container" style="border: none; background: transparent; padding: 0 0 1rem 0; margin-bottom: 1rem; border-bottom: 1px solid var(--border);">
        <div class="mini-calendar-header">
          <div class="mini-cal-title-group">
            <div class="mini-cal-label">
              <span>วันที่เลือกปิดซ่อม:</span>
            </div>
            <div class="mini-cal-selected-text">
              <span><%= formattedThaiDate %></span>
              <% if (isToday) { %>
                <span class="mini-cal-today-badge">วันนี้</span>
              <% } %>
            </div>
          </div>

          <div class="mini-cal-actions">
            <% if (!isToday) { %>
              <button type="button" class="mini-cal-today-btn" onclick="changeBookingDate('<%= todayStr %>')">
                กลับสู่วันนี้
              </button>
            <% } %>
            <div class="mini-cal-picker-form">
              <input type="date" value="<%= selectedDate %>" min="<%= todayStr %>" onchange="changeBookingDate(this.value)" class="form-control mini-cal-date-input" title="คลิกเพื่อเลือกวันอื่นในปฏิทิน">
            </div>
          </div>
        </div>

        <!-- แถบปฏิทินจิ๋ว 10 วัน -->
        <div class="mini-calendar-strip-wrap">
          <button type="button" class="mini-cal-nav-btn prev" onclick="navigateMiniCal(-1)" title="เลื่อนดูวันก่อนหน้า">&#8249;</button>
          <div class="mini-calendar-strip">
            <% miniCalDays.forEach(day => { %>
              <div class="mini-cal-day-card <%= day.isSelected ? 'active' : '' %> <%= day.isToday ? 'is-today' : '' %> <%= day.isWeekend ? 'is-weekend' : '' %>"
                   onclick="changeBookingDate('<%= day.dateStr %>')">
                <div class="mini-cal-day-name"><%= day.dayName %></div>
                <div class="mini-cal-day-num"><%= day.dayNum %></div>
                <div class="mini-cal-day-month"><%= day.monthName %></div>
                <% if (day.isToday) { %><div class="mini-cal-today-dot"></div><% } %>
              </div>
            <% }) %>
          </div>
          <button type="button" class="mini-cal-nav-btn next" onclick="navigateMiniCal(1)" title="เลื่อนดูวันถัดไป">&#8250;</button>
        </div>
      </div>

      <!-- แถบคำแนะนำการเลือกเวลา -->
      <div id="maintSlotGuidePill" class="conflict-status-banner" style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a; margin-bottom: 0.75rem; text-align: center;">
        แตะช่องเวลาเพื่อกำหนดเวลาเริ่มต้น แล้วแตะเวลาสิ้นสุด
      </div>

      <!-- Time Range Grid สล็อตเวลา 09:00 - 18:00 (Hourly Buttons พร้อมปุ่มสิ้นสุด 18:00) -->
      <div class="time-range-picker-grid" id="maintTimeRangeGrid">
        <% for (let h = 9; h <= 18; h++) { 
          const hourStr = `${String(h).padStart(2, '0')}:00`;
          const nextHourStr = `${String(h+1).padStart(2, '0')}:00`;
        %>
          <div class="time-slot-pill maint-time-pill" data-hour="<%= h %>" data-time="<%= hourStr %>" onclick="onMaintTimeRangePillClick(<%= h %>)" title="<%= h < 18 ? `${hourStr} - ${nextHourStr} น.` : '18:00 น. (เวลาสิ้นสุด / อาคารปิดทำการ)' %>">
            <%= hourStr %>
          </div>
        <% } %>
      </div>

      <!-- Input selects เวลาเริ่มต้น และเวลาสิ้นสุด -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem;">
        <div>
          <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">เวลาเริ่มต้นปิดซ่อม:</label>
          <select name="start_time_str" id="maint_start_time" class="form-control" onchange="onMaintStartTimeChange()" required style="height: 38px; font-weight: 700;">
            <% for (let h = 9; h < 18; h++) { 
              const hourStr = `${String(h).padStart(2, '0')}:00`;
            %>
              <option value="<%= hourStr %>"><%= hourStr %> น.</option>
            <% } %>
          </select>
        </div>
        <div>
          <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">เวลาสิ้นสุดปิดซ่อม:</label>
          <select name="end_time_str" id="maint_end_time" class="form-control" onchange="checkMaintConflict()" required style="height: 38px; font-weight: 700;">
            <% for (let h = 10; h <= 18; h++) { 
              const hourStr = `${String(h).padStart(2, '0')}:00`;
            %>
              <option value="<%= hourStr %>"><%= hourStr %> น.</option>
            <% } %>
          </select>
        </div>
      </div>

      <!-- สถานะความพร้อมในการบล็อก (Conflict Banner) -->
      <div id="maintConflictBanner" class="conflict-status-banner is-free" style="margin-top: 0.75rem;">
        <span>พร้อมทำการบล็อกช่วงเวลานี้</span>
      </div>
    </div>

    <!-- ================= STEP 3: รายละเอียดเหตุผลการปิดห้อง ================= -->
    <div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--danger);">
      <div style="font-size: 0.95rem; font-weight: 800; color: var(--dark); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
        <span style="background: var(--danger); color: white; border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">3</span>
        <span>ระบุเหตุผลการปิดห้องซ่อมบำรุง / งานพิเศษ:</span>
      </div>

      <!-- ปุ่มเหตุผลมาตรฐานด่วนคลิกเดียว -->
      <div style="margin-bottom: 0.75rem;">
        <div style="font-size: 0.78rem; font-weight: 700; color: var(--muted); margin-bottom: 0.35rem;">
          เลือกเหตุผลด่วน:
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
          <button type="button" class="maint-preset-btn" onclick="setMaintPresetReason('ปิดตรวจเช็กระบบแอร์ประจำเดือน')">❄️ ตรวจเช็กระบบแอร์</button>
          <button type="button" class="maint-preset-btn" onclick="setMaintPresetReason('ซ่อมแซมระบบไฟฟ้าและโคมไฟ')">💡 ซ่อมระบบไฟ</button>
          <button type="button" class="maint-preset-btn" onclick="setMaintPresetReason('บำรุงรักษาระบบโปรเจกเตอร์และเครื่องเสียง')">📽️ ซ่อมโปรเจกเตอร์/เสียง</button>
          <button type="button" class="maint-preset-btn" onclick="setMaintPresetReason('ทำความสะอาดและพ่นยาฆ่าเชื้อประจำรอบ')">🧹 ทำความสะอาด/พ่นฆ่าเชื้อ</button>
          <button type="button" class="maint-preset-btn" onclick="setMaintPresetReason('กิจกรรมสัมมนาใหญ่ส่วนกลางของบริษัท')">🏢 กิจกรรมส่วนกลาง</button>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label for="maint_reason_input" style="font-size: 0.82rem; font-weight: 700;">ข้อความเหตุผลที่จะแสดงในระบบ *</label>
        <input type="text" name="reason" id="maint_reason_input" class="form-control" placeholder="เช่น ปิดตรวจเช็กระบบแอร์ประจำเดือน" required value="ปิดตรวจเช็กระบบแอร์ประจำเดือน">
      </div>

      <button type="submit" id="maintSubmitBtn" class="btn btn-danger" style="width: 100%; font-weight: 800; padding: 0.85rem; font-size: 1rem; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);">
        ยืนยันบล็อกปิดห้องซ่อมบำรุง
      </button>
    </div>
  </form>

  <!-- ================= ส่วนแสดงรายการห้องที่ปิดซ่อมในวันนี้ ================= -->
  <div class="card" style="border-left: 4px solid var(--slate);">
    <div class="card-title" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
      <span style="display: flex; align-items: center; gap: 0.4rem; font-size: 1rem; font-weight: 800;">
        <span>📋</span> รายการที่ปิดซ่อมในวันที่เลือก
      </span>
      <span style="font-size: 0.82rem; color: var(--muted);"><%= selectedDate %></span>
    </div>

    <% 
      const blockedBookingsToday = dayBookings.filter(b => b.status === 'BLOCKED');
    %>
    <% if (blockedBookingsToday.length === 0) { %>
      <div style="text-align: center; padding: 2.5rem; color: var(--muted); font-size: 0.88rem;">
        <div style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.7;">✅</div>
        ไม่มีรายการบล็อกปิดซ่อมในวันที่เลือก<br>
        ทุกห้องเปิดให้ใช้งานตามปกติ
      </div>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.85rem;">
        <% blockedBookingsToday.forEach(b => { 
          const bStart = new Date(b.start_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
          const bEnd = new Date(b.end_time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
        %>
          <div style="padding: 1rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.35rem;">
                <strong style="color: var(--dark); font-size: 1rem;"><%= b.room_name %></strong>
                <span class="status-badge status-BLOCKED" style="font-size: 0.7rem; padding: 2px 8px; font-weight: 700;">BLOCKED</span>
              </div>
              <div style="font-size: 0.85rem; color: #b45309; font-weight: 700; margin-bottom: 0.35rem;">
                ⏰ <%= bStart %> - <%= bEnd %> น.
              </div>
              <div style="font-size: 0.8rem; color: var(--muted);">
                <strong>เหตุผล:</strong> <%= b.title ? b.title.replace(/^\[บล็อก\]\s*/, '') : 'ปิดซ่อมบำรุง' %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
