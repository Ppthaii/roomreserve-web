<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body style="background: #0f172a; color: white; display: flex; align-items: center; justify-content: center; min-height: 100vh;">
  <div style="background: #1e293b; padding: 3rem; border-radius: 16px; text-align: center; max-width: 500px; width: 90%; border: 1px solid #334155; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
    <div style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; color: #ef4444;"><%= code %></div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem; color: #f87171;"><%= title %></h1>
    <p style="color: #94a3b8; margin-bottom: 2rem; font-size: 1rem; line-height: 1.5;"><%= message %></p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="/app" class="btn btn-primary">กลับหน้าหลัก</a>
      <a href="/login" class="btn btn-outline" style="color: white; border-color: #475569;">ไปหน้าเข้าสู่ระบบ</a>
    </div>
  </div>
</body>
</html>
