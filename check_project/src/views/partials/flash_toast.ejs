<% 
  const flashSuccess = typeof success !== 'undefined' ? success : '';
  const flashError = typeof error !== 'undefined' ? error : '';
%>
<% if (flashSuccess || flashError) { %>
  <div id="flashToastNotification" class="floating-toast <%= flashSuccess ? 'floating-toast-success' : 'floating-toast-danger' %>" role="alert" aria-live="assertive">
    <div class="floating-toast-icon">
      <% if (flashSuccess) { %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      <% } else { %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      <% } %>
    </div>
    <div class="floating-toast-content">
      <div class="floating-toast-title"><%= flashSuccess ? 'ดำเนินการสำเร็จ' : 'ข้อผิดพลาด' %></div>
      <div class="floating-toast-message"><%= flashSuccess || flashError %></div>
    </div>
    <button type="button" class="floating-toast-close" onclick="dismissFloatingToast()" title="ปิดการแจ้งเตือน" aria-label="Close">
      &times;
    </button>
  </div>
  <script>
    (function() {
      const toastEl = document.getElementById('flashToastNotification');
      function dismissFloatingToast() {
        if (!toastEl) return;
        toastEl.classList.add('floating-toast-hiding');
        setTimeout(() => {
          if (toastEl && toastEl.parentElement) {
            toastEl.parentElement.removeChild(toastEl);
          }
        }, 320);
      }
      window.dismissFloatingToast = dismissFloatingToast;

      let toastTimer = setTimeout(dismissFloatingToast, 4500);
      if (toastEl) {
        toastEl.addEventListener('mouseenter', () => clearTimeout(toastTimer));
        toastEl.addEventListener('mouseleave', () => {
          clearTimeout(toastTimer);
          toastTimer = setTimeout(dismissFloatingToast, 2500);
        });
      }
    })();
  </script>
<% } %>
