# Configuration for Web Application Project
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web_management_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Security & Session Secrets
SESSION_SECRET=your_super_secret_session_key_change_in_production
JWT_SECRET=your_jwt_secret_key_if_using_token

# File Upload Constraints
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=./uploads
